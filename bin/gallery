#!/usr/bin/env bash
#
# gallery -- thin CLI over the Hammerspoon IPC command for The Gallery Spoon.
# Modelled on Omarchy 4's `omarchy plugin` CLI.
#
# open/close/toggle resolve the plugin's manifest first: a `tui` or `menu`
# kind plugin is handled entirely in bash (gallery-tui/gallery-menu, no
# Hammerspoon involved -- see those scripts); panel/overlay still go over
# the Hammerspoon IPC call (run_ipc/hs_call) below, unchanged.
#
# Usage:
#   gallery status
#   gallery list [--json]
#   gallery open <id> [panel|overlay|menu|tui]
#   gallery close <id> [panel|overlay|menu|tui]
#   gallery toggle <id> [panel|overlay|menu|tui]
#   gallery enable <id>
#   gallery disable <id>
#   gallery add <git-url> [--enable] [--yes]
#   gallery update [id]
#   gallery remove <id> [--yes]
#   gallery clone <id> <new-id>
#   gallery validate <dir>
#   gallery theme list
#   gallery theme current
#   gallery theme set <name>
#   gallery theme render
#   gallery theme next
#   gallery bg list [theme]
#   gallery bg current [theme]
#   gallery bg set <file> [theme]
#   gallery bg next [theme]
#   gallery bg prev [theme]
#   gallery bg apply [theme]
#   gallery console status
#   gallery console theme
#   gallery console native
#   gallery console toggle
#   gallery borders status
#   gallery borders width <1-12>
#   gallery borders bright on|off|toggle
#   gallery reload
#   gallery log
#   gallery doctor
#   gallery install
#
set -euo pipefail

# Callers such as skhd or launchd may not carry the Homebrew path; hs lives there.
export PATH="${PATH}:/opt/homebrew/bin:/usr/local/bin:${HOME}/bin"

CONFIG_DIR="${HOME}/.config/gallery"
PLUGIN_DIR="${CONFIG_DIR}/plugins"
STAGING_DIR="${CONFIG_DIR}/staging"
REMOVED_DIR="${CONFIG_DIR}/removed"
GALLERY_JSON="${CONFIG_DIR}/gallery.json"
THEME_DIR="${CONFIG_DIR}/themes"
# GALLERY_THEME_HOOKS_DIR overrides the installed hooks dir -- used by tests
# to point at a repo checkout's tools/hooks/ instead of the installed copy.
THEME_HOOKS_DIR="${GALLERY_THEME_HOOKS_DIR:-${CONFIG_DIR}/hooks/theme-set.d}"
BACKGROUNDS_STATE_FILE="${CONFIG_DIR}/state/backgrounds.json"
CONSOLE_STATE_FILE="${CONFIG_DIR}/state/console.json"
BORDERS_STATE_FILE="${CONFIG_DIR}/state/borders.json"
# Installed by install.sh from this repo's patches/ directory -- see that
# directory's own README.md for the mechanism (macOS replacements for a
# plugin's own files, applied on top of the installed plugin dir).
PATCHES_DIR="${CONFIG_DIR}/patches"
# render-theme.py is installed onto the boot volume by install.sh (see the
# rationale comment there re: TCC and the external volume this repo lives
# on); fall back to the repo-relative copy for an uninstalled dev checkout.
RENDER_TOOL_INSTALLED="${CONFIG_DIR}/bin/render-theme.py"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LOG_FILE="${HOME}/Library/Logs/gallery.log"
RENDER_TOOL_REPO="${SCRIPT_DIR}/../tools/render-theme.py"

# Every IPC call uses the hs tool's own graceful timeout (-t). Never wrap hs in
# `timeout`: killing the client mid-request leaves Hammerspoon replying to a dead
# port, which has wedged and once crashed it. A request that lands during a
# config reload returns "error sending to remote" within a second; retry once.
HS_TIMEOUT="${GALLERY_HS_TIMEOUT:-10}"
hs_call() {
  # Delegates to gallery-hs, which carries the watchdog (temp file, kill -9
  # after HS_TIMEOUT seconds, single retry after 1.5s on the two transient
  # reload errors or the watchdog itself) described in that script's own
  # header comment. Resolve it next to this script first (dev checkout),
  # falling back to the installed copy in ~/bin (see install.sh).
  local gallery_hs="${SCRIPT_DIR}/gallery-hs"
  [ -x "${gallery_hs}" ] || gallery_hs="${HOME}/bin/gallery-hs"
  "${gallery_hs}" -t "${HS_TIMEOUT}" "$1"
}

usage() {
  cat >&2 << 'EOF'
usage: gallery <command> [args]

commands:
  status                          show Gallery status
  list [--json]                   list installed plugins
  open <id> [kind]                open a plugin (kind: panel|overlay|menu|tui)
  close <id> [kind]               close a plugin
  toggle <id> [kind]              toggle a plugin open/closed
  enable <id>                     enable a plugin
  disable <id>                    disable a plugin
  add <git-url> [--enable] [--yes]
                                   clone and install a plugin from git
  update [id]                     pull latest commits for git-managed plugin(s)
  remove <id> [--yes]             disable and remove a plugin
  clone <id> <new-id>             duplicate an installed plugin under a new id
  patch <id>                      reapply ~/.config/gallery/patches/<id> over the installed plugin
  validate <dir>                  validate a plugin manifest directory
  theme list                      list installed themes (marks current, light)
  theme current                   print the active theme name
  theme set <name>                switch the active theme and re-render it
  theme render                    re-run the renderers for the active theme
  theme next                      switch to the next theme alphabetically
  bg list [theme]                 list backgrounds for a theme (marks active)
  bg current [theme]              print the active background's filename
  bg set <file> [theme]           choose a background and apply it
  bg next [theme]                 cycle to the next background, and apply it
  bg prev [theme]                 cycle to the previous background, and apply it
  bg apply [theme]                re-apply the active background
  console status                  show whether the iTerm console follows the theme
  console theme                   make the iTerm console follow the active theme
  console native                  restore the iTerm console to its own Default colours
  console toggle                  flip between theme and native
  borders status                  show the focused-window border width/bright prefs
  borders width <1-12>            set the focused-window border width (default 5)
  borders bright on|off|toggle    mix the active border colour toward bright_foreground
  reload                          request a Hammerspoon config reload
  log                             tail the Gallery log
  doctor                          check the local Gallery install
  install                         run install.sh
EOF
}

require_hs() {
  if ! command -v hs >/dev/null 2>&1; then
    echo 'hs CLI not installed; run in Hammerspoon console: hs.ipc.cliInstall("/opt/homebrew")' >&2
    exit 1
  fi
}

valid_id() {
  case "$1" in
    ''|*[!A-Za-z0-9._-]*)
      return 1
      ;;
    *)
      return 0
      ;;
  esac
}

# Escape backslashes and single quotes so a string can be embedded safely
# inside a single-quoted Lua string literal.
lua_escape() {
  printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e "s/'/\\\\'/g"
}

# ipc_call <verb> [arg...] -- builds spoon.Gallery:ipc('verb', 'arg', ...)
# and calls hs_call. Every argument is Lua-escaped, so this is safe to use
# both for plugin ids (already charset-restricted by valid_id) and for
# free-form values such as filesystem paths.
ipc_call() {
  local verb="$1"
  shift
  local expr
  expr="spoon.Gallery:ipc('$(lua_escape "${verb}")'"
  local a
  for a in "$@"; do
    expr="${expr}, '$(lua_escape "${a}")'"
  done
  expr="${expr})"
  require_hs
  hs_call "return ${expr}"
}

# run_ipc <verb> [id] -- id-validated passthrough that prints Gallery's
# reply directly (not captured), matching the CLI's original open/close/
# toggle/status behaviour.
run_ipc() {
  local verb="$1"
  local id="${2:-}"
  local kind="${3:-}"
  if [ -n "${id}" ]; then
    if ! valid_id "${id}"; then
      echo "gallery: invalid id: ${id}" >&2
      exit 1
    fi
    if [ -n "${kind}" ]; then
      case "${kind}" in
        panel|overlay|menu|tui) ;;
        *) echo "gallery: invalid kind: ${kind} (panel|overlay|menu|tui)" >&2; exit 1 ;;
      esac
      ipc_call "${verb}" "${id}" "${kind}"
    else
      ipc_call "${verb}" "${id}"
    fi
  else
    ipc_call "${verb}"
  fi
}

# --- tui/menu/qml: handled locally (no Hammerspoon), everything else over --
# --- IPC ---------------------------------------------------------------
#
# open/close/toggle need to know a plugin's *effective* kind before they can
# decide whether to route to gallery-tui/gallery-menu/gallery-qml (tui,
# menu, qml) or over IPC (panel, overlay), same priority order as
# Gallery.spoon/init.lua's resolveKind/primaryInteractiveKind: an explicit
# kind argument wins outright; otherwise manifest.gallery.primaryKind if it
# names a declared kind, else the first of tui > panel > overlay > menu
# that the manifest declares -- EXCEPT that once "panel" or "overlay" is
# chosen by any of those paths, it is reported as "qml" instead whenever
# that kind's entryPoints value ends in ".qml": an unmodified Omarchy
# plugin (unlike our own kinds, which never ship a .qml entry point) runs
# under the Quickshell-for-macOS host (bin/gallery-qml), not a native
# Gallery panel/overlay. That is the "qml" step in the doc'd priority
# order (explicit kind > primaryKind > tui > qml > panel > overlay >
# menu): it only ever fires in place of a panel/overlay that would
# otherwise have been chosen.
#
# PY_RESOLVE_KIND prints NUL-separated fields so the bash reader below
# never has to fight IFS word-splitting or bash's (3.2-era) empty-array
# handling: effective-kind, name, tui.grid, tui.command, qml-entry-point,
# then zero or more tui.args. A missing/unreadable manifest or missing
# python3 yields an empty effective-kind, which tells the caller to fall
# back to the original IPC passthrough untouched.
read -r -d '' PY_RESOLVE_KIND <<'PYEOF' || true
import json, sys

manifest_path = sys.argv[1]
kind_arg = sys.argv[2] if len(sys.argv) > 2 else ""


def emit(fields):
    out = sys.stdout.buffer
    for f in fields:
        out.write(str(f).encode("utf-8", "surrogateescape"))
        out.write(b"\x00")


try:
    with open(manifest_path, encoding="utf-8") as fh:
        data = json.load(fh)
except Exception:
    emit(["", "", "", "", ""])
    sys.exit(0)

kinds = data.get("kinds")
if not isinstance(kinds, list):
    kinds = []
gallery = data.get("gallery")
if not isinstance(gallery, dict):
    gallery = {}
entryPoints = data.get("entryPoints")
if not isinstance(entryPoints, dict):
    entryPoints = {}
name = data.get("name")
if not isinstance(name, str) or not name:
    name = data.get("id") if isinstance(data.get("id"), str) else ""


def has(k):
    return k in kinds


def qml_entry_for(k):
    # Omarchy manifests only ever put a .qml file behind "panel" or
    # "overlay"; a non-string/non-.qml entry point (or none at all) means
    # this kind is not qml-backed.
    ep = entryPoints.get(k)
    if isinstance(ep, str) and ep.endswith(".qml"):
        return ep
    return ""


if kind_arg:
    eff = kind_arg
else:
    primary = gallery.get("primaryKind")
    if primary in ("tui", "panel", "overlay", "menu") and has(primary):
        eff = primary
    elif has("tui"):
        eff = "tui"
    elif has("panel"):
        eff = "panel"
    elif has("overlay"):
        eff = "overlay"
    elif has("menu"):
        eff = "menu"
    else:
        eff = ""

# Whatever chose "panel"/"overlay" above (explicit, primaryKind, or the
# ladder), a .qml entry point behind it means "qml" instead.
qml_entry = ""
if eff in ("panel", "overlay"):
    qml_entry = qml_entry_for(eff)
    if qml_entry:
        eff = "qml"
elif eff == "qml":
    # Caller passed kind_arg="qml" explicitly (e.g. the Spoon shelling back
    # out to `gallery <verb> <id> qml` -- see shellOutQml in init.lua):
    # find the entry point ourselves rather than trusting the caller to
    # have known which of panel/overlay carries it.
    qml_entry = qml_entry_for("panel") or qml_entry_for("overlay")

grid = ""
command = ""
args = []
if eff == "tui":
    tui = gallery.get("tui")
    if not isinstance(tui, dict):
        tui = {}
    if isinstance(tui.get("grid"), str):
        grid = tui.get("grid")
    if isinstance(tui.get("command"), str):
        command = tui.get("command")
    if isinstance(tui.get("args"), list):
        args = [str(a) for a in tui.get("args")]

emit([eff, name, grid, command, qml_entry] + args)
PYEOF

# resolve_helper_bin <name> -- find gallery-tui / gallery-menu next to this
# script first (dev checkout), falling back to the installed copy in
# ~/bin, same pattern as hs_call's gallery-hs resolution above.
resolve_helper_bin() {
  local name="$1"
  local candidate="${SCRIPT_DIR}/${name}"
  if [ -x "${candidate}" ]; then
    printf '%s' "${candidate}"
  else
    printf '%s' "${HOME}/bin/${name}"
  fi
}

# apply_patches <id> -- copies every file under
# ~/.config/gallery/patches/<id>/ over the installed plugin dir
# ~/.config/gallery/plugins/<id>/, preserving exec bits, and prints "applied
# N patch file(s) for <id>" (N=0 is not printed -- most plugins have no
# patch directory at all). Used by both `gallery add` (after cloning) and
# `gallery update` (after pulling), and directly by `gallery patch <id>`.
# Never raises: a missing patches dir or destination is simply a no-op.
apply_patches() {
  local id="$1"
  local src="${PATCHES_DIR}/${id}"
  local dest="${PLUGIN_DIR}/${id}"

  [ -d "${src}" ] || return 0
  [ -d "${dest}" ] || return 0

  local count=0 rel
  while IFS= read -r -d '' file; do
    rel="${file#"${src}"/}"
    mkdir -p "$(dirname "${dest}/${rel}")"
    cp -p "${file}" "${dest}/${rel}"
    count=$((count + 1))
  done < <(find "${src}" -type f -print0)

  if [ "${count}" -gt 0 ]; then
    echo "applied ${count} patch file(s) for ${id}"
  fi
}

# is_disabled <id> -- true if id is listed in gallery.json's disabled[].
# Missing gallery.json or python3 means "not disabled" (nothing to refuse).
is_disabled() {
  local id="$1"
  command -v python3 >/dev/null 2>&1 || return 1
  [ -f "${GALLERY_JSON}" ] || return 1
  python3 -c '
import json, sys
path, target = sys.argv[1], sys.argv[2]
try:
    with open(path, encoding="utf-8") as f:
        data = json.load(f)
except Exception:
    sys.exit(1)
disabled = data.get("disabled")
sys.exit(0 if isinstance(disabled, list) and target in disabled else 1)
' "${GALLERY_JSON}" "${id}"
}

# run_gallery_tui <verb> <gallery_tui_bin> <name> <id> <gallery-tui args...>
# Invokes gallery-tui and translates its output into the same style of
# result line the Spoon's kind modules return ("opened <id>", "closed
# <id>", "not open: <id>") -- by id, not by the window title (name).
run_gallery_tui() {
  local verb="$1" gallery_tui="$2" name="$3" id="$4"
  shift 4
  local out="" rc=0
  out="$("${gallery_tui}" "${verb}" "${name}" "$@" 2>&1)" || rc=$?

  case "${verb}" in
    open)
      if [ "${rc}" -eq 0 ]; then
        echo "opened ${id}"
      else
        echo "gallery: ${out}" >&2
        return "${rc}"
      fi
      ;;
    close)
      if [ "${rc}" -ne 0 ]; then
        echo "gallery: ${out}" >&2
        return "${rc}"
      fi
      case "${out}" in
        "closed:"*) echo "closed ${id}" ;;
        "not open:"*) echo "not open: ${id}" ;;
        *) echo "closed ${id}" ;;
      esac
      ;;
    toggle)
      if [ "${rc}" -ne 0 ]; then
        echo "gallery: ${out}" >&2
        return "${rc}"
      fi
      case "${out}" in
        "closed:"*) echo "closed ${id}" ;;
        *) echo "opened ${id}" ;;
      esac
      ;;
  esac
  return 0
}

# route_open_close_toggle <verb> <id> <kind-arg>
# Resolves the plugin's effective kind and, for tui/menu/qml, handles the
# whole open/close/toggle locally (no Hammerspoon involved). Returns 2 to
# tell the caller to fall back to the original run_ipc passthrough
# unchanged -- used both for panel/overlay and for every case this
# function cannot resolve on its own (no manifest, no python3,
# GALLERY_PLUGIN_DIR pointing nowhere useful, etc).
route_open_close_toggle() {
  local verb="$1" id="$2" kind_arg="$3"
  local plugin_dir="${GALLERY_PLUGIN_DIR:-${PLUGIN_DIR}}"
  local manifest="${plugin_dir}/${id}/manifest.json"

  command -v python3 >/dev/null 2>&1 || return 2
  [ -f "${manifest}" ] || return 2

  local eff="" name="" grid="" tui_command="" qml_entry="" n=0
  set --
  while IFS= read -r -d '' field; do
    n=$((n + 1))
    case "${n}" in
      1) eff="${field}" ;;
      2) name="${field}" ;;
      3) grid="${field}" ;;
      4) tui_command="${field}" ;;
      5) qml_entry="${field}" ;;
      *) set -- "$@" "${field}" ;;
    esac
  done < <(python3 -c "${PY_RESOLVE_KIND}" "${manifest}" "${kind_arg}" 2>/dev/null)
  # "$@" now holds manifest.gallery.tui.args (zero or more).

  case "${eff}" in
    tui|menu|qml) ;;
    *) return 2 ;;
  esac

  [ -n "${name}" ] || name="${id}"

  if is_disabled "${id}"; then
    echo "not enabled: ${id}"
    return 0
  fi

  if [ "${eff}" = "qml" ]; then
    route_qml "${verb}" "${id}" "${plugin_dir}/${id}" "${name}" "${qml_entry}"
    return $?
  fi

  local gallery_tui
  gallery_tui="$(resolve_helper_bin gallery-tui)"

  if [ "${eff}" = "tui" ]; then
    if [ "${verb}" = "close" ]; then
      # gallery-tui close only ever needs the title -- no need to gate a
      # close on gallery.tui.command being present.
      run_gallery_tui "${verb}" "${gallery_tui}" "${name}" "${id}"
    elif [ -z "${tui_command}" ]; then
      echo "gallery: ${id}: tui plugin has no gallery.tui.command" >&2
      return 1
    elif [ -n "${grid}" ]; then
      run_gallery_tui "${verb}" "${gallery_tui}" "${name}" "${id}" --grid "${grid}" -- "${tui_command}" "$@"
    else
      run_gallery_tui "${verb}" "${gallery_tui}" "${name}" "${id}" -- "${tui_command}" "$@"
    fi
  else
    local gallery_menu
    gallery_menu="$(resolve_helper_bin gallery-menu)"
    run_gallery_tui "${verb}" "${gallery_tui}" "${name}" "${id}" -- "${gallery_menu}" "${id}"
  fi
}

# --- qml: unmodified Omarchy plugins run under bin/gallery-qml, no --------
# --- Hammerspoon involved (pure bash + a pidfile + yabai, same spirit as --
# --- the tui kind above) --------------------------------------------------
#
# QML_STATE_DIR mirrors gallery-qml's own pidfile location
# (~/.config/gallery/state/qml/<title-slug>.pid); the slug is computed the
# same way here as gallery-qml computes it from its own --title argument
# (the manifest's `name`, not the "Gallery: " prefixed window title) --
# lowercased, every non-alphanumeric character replaced with "-", one for
# one (no collapsing of runs, no trimming) -- so the two never disagree
# about where the pidfile lives.
QML_STATE_DIR="${CONFIG_DIR}/state/qml"

qml_slug() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]/-/g'
}

qml_pidfile() {
  printf '%s/%s.pid' "${QML_STATE_DIR}" "$(qml_slug "$1")"
}

qml_pid_alive() {
  local pid="$1"
  [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null
}

# ensure_gallery_qml_yabai_rule -- idempotent float/centre rule for every
# Gallery-titled Qt window (the qml-kind twin of gallery-tui's own
# ensure_yabai_rule, which this deliberately does not touch -- no app
# filter here, since these are not iTerm2 windows). Removed and re-added
# each call so it is always present and current. Silently skipped if
# yabai is not installed.
ensure_gallery_qml_yabai_rule() {
  command -v yabai >/dev/null 2>&1 || return 0
  yabai -m rule --remove gallery-qml >/dev/null 2>&1 || true
  # No grid: a QML plugin sizes its own window (the host centres it).
  yabai -m rule --add label=gallery-qml title="^Gallery: " manage=off >/dev/null 2>&1 || true
}

# qml_focus_window <title> -- find a window with this exact title via
# yabai and focus it. Returns 1 (no-op) if yabai is missing or no such
# window is found.
qml_focus_window() {
  local title="$1"
  command -v yabai >/dev/null 2>&1 || return 1
  local id
  id="$(yabai -m query --windows 2>/dev/null | python3 -c '
import json, sys
title = sys.argv[1]
try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(1)
for w in data:
    if isinstance(w, dict) and w.get("title") == title:
        print(w.get("id"))
        sys.exit(0)
sys.exit(1)
' "${title}" 2>/dev/null)" || return 1
  [ -n "${id}" ] || return 1
  yabai -m window "${id}" --focus >/dev/null 2>&1 || true
  return 0
}

# qml_kill <pid> -- TERM, then KILL after ~2s if it is still alive.
qml_kill() {
  local pid="$1"
  kill -TERM "${pid}" 2>/dev/null || return 0
  local i=0
  while [ "${i}" -lt 20 ]; do
    qml_pid_alive "${pid}" || return 0
    sleep 0.1
    i=$((i + 1))
  done
  kill -KILL "${pid}" 2>/dev/null || true
}

# qml_launch <this-plugin-dir> <name> <entry> -- resolves gallery-qml next
# to this script first (dev checkout), falling back to ~/bin (see
# resolve_helper_bin), ensures the yabai float rule, and launches it
# detached: the pidfile it writes on start is what future open/close/
# toggle calls key off, and it exits on its own once the window closes.
qml_launch() {
  local this_plugin_dir="$1" name="$2" entry="$3"
  local gallery_qml
  gallery_qml="$(resolve_helper_bin gallery-qml)"
  if [ ! -x "${gallery_qml}" ]; then
    echo "gallery: gallery-qml not found (looked for ${gallery_qml})" >&2
    return 1
  fi
  ensure_gallery_qml_yabai_rule
  mkdir -p "${QML_STATE_DIR}"
  local log="${HOME}/Library/Logs/gallery-qml.log"
  if [ -n "${entry}" ]; then
    nohup "${gallery_qml}" "${this_plugin_dir}" "${entry}" --title "${name}" >/dev/null 2>>"${log}" &
  else
    nohup "${gallery_qml}" "${this_plugin_dir}" --title "${name}" >/dev/null 2>>"${log}" &
  fi
  disown
}

# route_qml <verb> <id> <this-plugin-dir> <name> <entry> -- the whole
# open/close/toggle dance for a qml-kind plugin, mirroring the result
# lines the tui path prints ("opened <id>", "closed <id>", "not open:
# <id>") so bin/gallery's own callers (and skhd) cannot tell the
# difference.
route_qml() {
  local verb="$1" id="$2" this_plugin_dir="$3" name="$4" entry="$5"

  local pidfile pid="" running=0
  pidfile="$(qml_pidfile "${name}")"
  if [ -f "${pidfile}" ]; then
    pid="$(cat "${pidfile}" 2>/dev/null || true)"
  fi
  if qml_pid_alive "${pid}"; then
    running=1
  elif [ -n "${pid}" ]; then
    rm -f "${pidfile}" 2>/dev/null || true
  fi

  case "${verb}" in
    open)
      if [ "${running}" -eq 1 ]; then
        qml_focus_window "Gallery: ${name}"
      else
        qml_launch "${this_plugin_dir}" "${name}" "${entry}" || return 1
      fi
      echo "opened ${id}"
      ;;
    close)
      if [ "${running}" -eq 1 ]; then
        qml_kill "${pid}"
        rm -f "${pidfile}" 2>/dev/null || true
        echo "closed ${id}"
      else
        echo "not open: ${id}"
      fi
      ;;
    toggle)
      if [ "${running}" -eq 1 ]; then
        qml_kill "${pid}"
        rm -f "${pidfile}" 2>/dev/null || true
        echo "closed ${id}"
      else
        qml_launch "${this_plugin_dir}" "${name}" "${entry}" || return 1
        echo "opened ${id}"
      fi
      ;;
    *)
      echo "gallery: route_qml: unknown verb: ${verb}" >&2
      return 1
      ;;
  esac
}

cmd_status() {
  run_ipc status
}

cmd_list() {
  if [ "${1:-}" = "--json" ]; then
    local out
    if ! out="$(ipc_call list-json)"; then
      exit 1
    fi
    case "${out}" in
      "unknown verb:"*)
        echo "gallery: Spoon does not yet support 'list-json' (${out})" >&2
        exit 1
        ;;
    esac
    if command -v python3 >/dev/null 2>&1; then
      printf '%s\n' "${out}" | python3 -m json.tool 2>/dev/null || printf '%s\n' "${out}"
    else
      printf '%s\n' "${out}"
    fi
    return 0
  fi

  local out
  if ! out="$(ipc_call list)"; then
    exit 1
  fi
  case "${out}" in
    "unknown verb:"*)
      echo "gallery: ${out}" >&2
      exit 1
      ;;
  esac
  if [ -z "${out}" ]; then
    echo "no plugins"
    return 0
  fi
  { printf 'ID\tVERSION\tKINDS\tSTATUS\n'; printf '%s\n' "${out}"; } | column -t -s "$(printf '\t')"
}

cmd_open() {
  local id="${1:?usage: gallery open <id> [panel|overlay|menu|tui]}"
  local kind="${2:-}"
  if ! valid_id "${id}"; then
    echo "gallery: invalid id: ${id}" >&2
    exit 1
  fi
  local rc=0
  route_open_close_toggle open "${id}" "${kind}" || rc=$?
  if [ "${rc}" -eq 2 ]; then
    run_ipc open "${id}" "${kind}"
    return
  fi
  return "${rc}"
}

cmd_close() {
  local id="${1:?usage: gallery close <id> [panel|overlay|menu|tui]}"
  local kind="${2:-}"
  if ! valid_id "${id}"; then
    echo "gallery: invalid id: ${id}" >&2
    exit 1
  fi
  local rc=0
  route_open_close_toggle close "${id}" "${kind}" || rc=$?
  if [ "${rc}" -eq 2 ]; then
    run_ipc close "${id}" "${kind}"
    return
  fi
  return "${rc}"
}

cmd_toggle() {
  local id="${1:?usage: gallery toggle <id> [panel|overlay|menu|tui]}"
  local kind="${2:-}"
  if ! valid_id "${id}"; then
    echo "gallery: invalid id: ${id}" >&2
    exit 1
  fi
  local rc=0
  route_open_close_toggle toggle "${id}" "${kind}" || rc=$?
  if [ "${rc}" -eq 2 ]; then
    run_ipc toggle "${id}" "${kind}"
    return
  fi
  return "${rc}"
}

cmd_enable() {
  local id="${1:?usage: gallery enable <id>}"
  run_ipc enable "${id}"
}

cmd_disable() {
  local id="${1:?usage: gallery disable <id>}"
  run_ipc disable "${id}"
}

cmd_validate() {
  local dir="${1:?usage: gallery validate <dir>}"
  local abs
  if ! abs="$(cd "${dir}" 2>/dev/null && pwd)"; then
    echo "gallery: no such directory: ${dir}" >&2
    exit 1
  fi

  local out
  if ! out="$(ipc_call validate "${abs}")"; then
    exit 1
  fi
  case "${out}" in
    "unknown verb:"*)
      echo "gallery: Spoon does not yet support 'validate' (${out})" >&2
      exit 1
      ;;
    ok)
      echo "ok"
      ;;
    errors:*)
      printf '%s\n' "${out}" >&2
      exit 1
      ;;
    *)
      printf '%s\n' "${out}"
      ;;
  esac
}

cmd_add() {
  local url="" do_enable=0 assume_yes=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --enable)
        do_enable=1
        ;;
      --yes)
        assume_yes=1
        ;;
      -*)
        echo "gallery: unknown option: $1" >&2
        exit 1
        ;;
      *)
        if [ -z "${url}" ]; then
          url="$1"
        else
          echo "gallery: unexpected argument: $1" >&2
          exit 1
        fi
        ;;
    esac
    shift
  done

  if [ -z "${url}" ]; then
    echo "usage: gallery add <git-url> [--enable] [--yes]" >&2
    exit 1
  fi

  cat >&2 << 'EOF'
Plugins run as arbitrary, unsandboxed code inside your Hammerspoon session
with everything your user account can reach.
EOF

  if [ "${assume_yes}" -ne 1 ]; then
    printf 'Continue? [y/N] ' >&2
    local reply
    read -r reply || reply=""
    case "${reply}" in
      y|Y|yes|YES) : ;;
      *)
        echo "gallery: aborted" >&2
        exit 1
        ;;
    esac
  fi

  command -v git >/dev/null 2>&1 || { echo "gallery: git not found on PATH" >&2; exit 1; }
  command -v python3 >/dev/null 2>&1 || { echo "gallery: python3 not found on PATH" >&2; exit 1; }

  mkdir -p "${STAGING_DIR}"
  local staging
  if ! staging="$(mktemp -d "${STAGING_DIR}/plugin.XXXXXXXX")"; then
    echo "gallery: failed to create staging directory under ${STAGING_DIR}" >&2
    exit 1
  fi
  trap 'rm -rf "${staging}" 2>/dev/null || true' EXIT

  if ! git clone --depth 1 "${url}" "${staging}" >&2; then
    echo "gallery: git clone failed: ${url}" >&2
    exit 1
  fi

  if [ ! -f "${staging}/manifest.json" ]; then
    echo "gallery: no manifest.json in cloned plugin" >&2
    exit 1
  fi

  local id
  if ! id="$(python3 -c '
import json, sys
with open(sys.argv[1]) as f:
    data = json.load(f)
pid = data.get("id")
if not pid:
    sys.exit(1)
sys.stdout.write(pid)
' "${staging}/manifest.json")"; then
    echo "gallery: manifest.json has no id" >&2
    exit 1
  fi

  if ! valid_id "${id}"; then
    echo "gallery: manifest id is not a valid plugin id: ${id}" >&2
    exit 1
  fi

  local vout
  if vout="$(ipc_call validate "${staging}")"; then
    case "${vout}" in
      "unknown verb:"*)
        echo "gallery: Spoon does not yet support 'validate' -- skipping manifest validation (${vout})" >&2
        ;;
      errors:*)
        echo "gallery: manifest validation failed:" >&2
        printf '%s\n' "${vout}" >&2
        exit 1
        ;;
      warnings:*)
        printf '%s\n' "${vout}" >&2
        ;;
      ok) : ;;
      *)
        printf '%s\n' "${vout}" >&2
        ;;
    esac
  else
    echo "gallery: could not reach Hammerspoon to validate -- proceeding without validation" >&2
  fi

  local dest="${PLUGIN_DIR}/${id}"
  if [ -e "${dest}" ]; then
    echo "gallery: plugin already exists: ${id} (use 'gallery update ${id}')" >&2
    exit 1
  fi

  mkdir -p "${PLUGIN_DIR}"
  if ! mv "${staging}" "${dest}"; then
    echo "gallery: failed to install plugin to ${dest}" >&2
    exit 1
  fi
  trap - EXIT

  echo "installed ${id} -> ${dest}"

  apply_patches "${id}"

  local rout
  if rout="$(ipc_call rescan)"; then
    case "${rout}" in
      "unknown verb:"*)
        echo "gallery: Spoon does not yet support 'rescan' -- reload Gallery to pick up ${id} (${rout})" >&2
        ;;
      *)
        printf '%s\n' "${rout}"
        ;;
    esac
  else
    echo "gallery: failed to reach Hammerspoon for rescan" >&2
  fi

  if [ "${do_enable}" -eq 1 ]; then
    local eout
    if eout="$(ipc_call enable "${id}")"; then
      printf '%s\n' "${eout}"
    else
      echo "gallery: failed to enable ${id}" >&2
    fi
  fi
}

cmd_update() {
  local target="${1:-}"
  if [ -n "${target}" ] && ! valid_id "${target}"; then
    echo "gallery: invalid id: ${target}" >&2
    exit 1
  fi

  command -v git >/dev/null 2>&1 || { echo "gallery: git not found on PATH" >&2; exit 1; }

  if [ ! -d "${PLUGIN_DIR}" ]; then
    echo "gallery: no plugins directory: ${PLUGIN_DIR}" >&2
    exit 1
  fi

  local any=0 failures=0 dir id

  for dir in "${PLUGIN_DIR}"/*/; do
    [ -d "${dir}" ] || continue
    id="$(basename "${dir}")"
    if [ -n "${target}" ] && [ "${id}" != "${target}" ]; then
      continue
    fi
    if [ ! -e "${dir}.git" ]; then
      if [ -n "${target}" ]; then
        echo "gallery: ${id} is not a git checkout, cannot update" >&2
        exit 1
      fi
      continue
    fi
    any=1
    echo "== ${id} =="

    if ! ( cd "${dir}" && git fetch --quiet ); then
      echo "gallery: git fetch failed for ${id}" >&2
      failures=1
      continue
    fi

    local upstream
    if ! upstream="$( cd "${dir}" && git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null )"; then
      echo "gallery: ${id} has no upstream tracking branch, skipping" >&2
      failures=1
      continue
    fi

    ( cd "${dir}" && git log --oneline "HEAD..@{u}" ) || true
    ( cd "${dir}" && git diff --stat "HEAD..@{u}" ) || true

    if ! ( cd "${dir}" && git pull --ff-only ); then
      echo "gallery: ${id} cannot be fast-forwarded (local changes or diverged history); resolve manually" >&2
      failures=1
      continue
    fi
    echo "updated ${id}"
    apply_patches "${id}"
  done

  if [ -n "${target}" ] && [ "${any}" -eq 0 ]; then
    echo "gallery: no such git-managed plugin: ${target}" >&2
    exit 1
  fi
  if [ -z "${target}" ] && [ "${any}" -eq 0 ]; then
    echo "no git-managed plugins to update"
  fi

  local rout
  if rout="$(ipc_call rescan)"; then
    case "${rout}" in
      "unknown verb:"*)
        echo "gallery: Spoon does not yet support 'rescan' (${rout})" >&2
        ;;
      *)
        printf '%s\n' "${rout}"
        ;;
    esac
  else
    echo "gallery: failed to reach Hammerspoon for rescan" >&2
    failures=1
  fi

  [ "${failures}" -eq 0 ]
}

cmd_remove() {
  local id="" assume_yes=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --yes)
        assume_yes=1
        ;;
      -*)
        echo "gallery: unknown option: $1" >&2
        exit 1
        ;;
      *)
        if [ -z "${id}" ]; then
          id="$1"
        else
          echo "gallery: unexpected argument: $1" >&2
          exit 1
        fi
        ;;
    esac
    shift
  done

  if [ -z "${id}" ]; then
    echo "usage: gallery remove <id> [--yes]" >&2
    exit 1
  fi
  if ! valid_id "${id}"; then
    echo "gallery: invalid id: ${id}" >&2
    exit 1
  fi

  local dir="${PLUGIN_DIR}/${id}"
  if [ ! -d "${dir}" ]; then
    echo "gallery: no such plugin: ${id}" >&2
    exit 1
  fi

  if [ "${assume_yes}" -ne 1 ]; then
    printf 'Remove plugin %s (%s)? [y/N] ' "${id}" "${dir}" >&2
    local reply
    read -r reply || reply=""
    case "${reply}" in
      y|Y|yes|YES) : ;;
      *)
        echo "gallery: aborted" >&2
        exit 1
        ;;
    esac
  fi

  local out
  if out="$(ipc_call disable "${id}")"; then
    case "${out}" in
      "unknown verb:"*) : ;;
      *) printf '%s\n' "${out}" ;;
    esac
  else
    echo "gallery: could not reach Hammerspoon to disable ${id}, continuing with removal" >&2
  fi

  if [ -e "${dir}/.git" ]; then
    rm -rf "${dir}"
    echo "removed ${id} (git checkout deleted)"
  else
    mkdir -p "${REMOVED_DIR}"
    local ts
    ts="$(date +%Y%m%dT%H%M%S)" || ts="$$"
    local dest="${REMOVED_DIR}/${id}-${ts}"
    mv "${dir}" "${dest}"
    echo "moved ${id} -> ${dest}"
  fi

  local rout
  if rout="$(ipc_call rescan)"; then
    case "${rout}" in
      "unknown verb:"*)
        echo "gallery: Spoon does not yet support 'rescan' (${rout})" >&2
        ;;
      *)
        printf '%s\n' "${rout}"
        ;;
    esac
  else
    echo "gallery: failed to reach Hammerspoon for rescan" >&2
  fi
}

cmd_patch() {
  local id="${1:?usage: gallery patch <id>}"
  if ! valid_id "${id}"; then
    echo "gallery: invalid id: ${id}" >&2
    exit 1
  fi
  if [ ! -d "${PLUGIN_DIR}/${id}" ]; then
    echo "gallery: no such plugin: ${id}" >&2
    exit 1
  fi
  if [ ! -d "${PATCHES_DIR}/${id}" ]; then
    echo "gallery: no patches for ${id} (looked in ${PATCHES_DIR}/${id})" >&2
    exit 1
  fi
  apply_patches "${id}"
}

cmd_clone() {
  local id="${1:?usage: gallery clone <id> <new-id>}"
  local new_id="${2:?usage: gallery clone <id> <new-id>}"

  if ! valid_id "${id}"; then
    echo "gallery: invalid id: ${id}" >&2
    exit 1
  fi
  if ! valid_id "${new_id}"; then
    echo "gallery: invalid id: ${new_id}" >&2
    exit 1
  fi

  command -v python3 >/dev/null 2>&1 || { echo "gallery: python3 not found on PATH" >&2; exit 1; }

  # Bundled plugins are copied into PLUGIN_DIR at install time (see
  # install.sh), so this is the only location a plugin ever lives in on a
  # running system -- there is no separate "shipped" path to fall back to.
  local src="${PLUGIN_DIR}/${id}"
  local dest="${PLUGIN_DIR}/${new_id}"

  if [ ! -d "${src}" ]; then
    echo "gallery: no such plugin: ${id}" >&2
    exit 1
  fi
  if [ -e "${dest}" ]; then
    echo "gallery: plugin already exists: ${new_id}" >&2
    exit 1
  fi
  if [ ! -f "${src}/manifest.json" ]; then
    echo "gallery: ${id} has no manifest.json, cannot clone" >&2
    exit 1
  fi

  cp -R "${src}" "${dest}"

  if ! python3 -c '
import json, sys
path, new_id = sys.argv[1], sys.argv[2]
with open(path) as f:
    data = json.load(f)
data["id"] = new_id
with open(path, "w") as f:
    json.dump(data, f, indent=2)
    f.write("\n")
' "${dest}/manifest.json" "${new_id}"; then
    echo "gallery: failed to rewrite manifest id, rolling back" >&2
    rm -rf "${dest}"
    exit 1
  fi

  echo "cloned ${id} -> ${new_id} (${dest})"

  local out
  if out="$(ipc_call rescan)"; then
    case "${out}" in
      "unknown verb:"*)
        echo "gallery: Spoon does not yet support 'rescan' (${out})" >&2
        ;;
      *)
        printf '%s\n' "${out}"
        ;;
    esac
  else
    echo "gallery: failed to reach Hammerspoon for rescan" >&2
  fi
}

# --- theme verbs ------------------------------------------------------------

# theme_current_name -- prints the basename of the theme `current` points at,
# or nothing if `current` is missing/not a symlink.
theme_current_name() {
  if [ -L "${THEME_DIR}/current" ]; then
    basename "$(readlink "${THEME_DIR}/current")"
  fi
}

# theme_is_light <dir> -- a theme is "light" if it ships an empty light.mode
# file (the flat contract this repo also accepts) or its colors.toml has
# mode = "light" (upstream Omarchy's actual convention as of 2026-09).
theme_is_light() {
  local dir="$1"
  if [ -f "${dir}/light.mode" ]; then
    return 0
  fi
  [ -f "${dir}/colors.toml" ] || return 1
  grep -Eq '^[[:space:]]*mode[[:space:]]*=[[:space:]]*"light"[[:space:]]*$' "${dir}/colors.toml"
}

# theme_names -- newline-separated, alphabetically sorted list of installed
# theme names (directories under THEME_DIR, excluding the `current` symlink).
theme_names() {
  local dir name list=""
  for dir in "${THEME_DIR}"/*/; do
    [ -d "${dir}" ] || continue
    name="$(basename "${dir}")"
    [ "${name}" = "current" ] && continue
    list="${list}${name}
"
  done
  [ -n "${list}" ] && printf '%s' "${list}" | sort
}

# --- background verbs -------------------------------------------------------
#
# Per-theme wallpaper choice, recorded in BACKGROUNDS_STATE_FILE
# (state/backgrounds.json: {"<theme>": "<basename>"}) and applied through
# the theme-set.d hook tools/hooks/30-wallpaper.sh (installed as
# 30-wallpaper.sh under THEME_HOOKS_DIR), which is the only thing that
# actually knows how to set the desktop picture. These helpers just resolve
# *which* background is active for a theme and read/write the state file;
# `gallery theme set`/`next` do not touch this state at all -- the hook
# reads it directly on every theme switch, so a previously recorded choice
# is honoured automatically.

# bg_is_image_ext <filename> -- same recognised-extension check as the
# wallpaper hook (jpg jpeg png heic webp, case-insensitive). Kept in sync
# with tools/hooks/30-wallpaper.sh's is_image_ext by hand; the two run in
# separate processes so there is nothing to share directly.
bg_is_image_ext() {
  local ext
  ext="$(printf '%s' "${1##*.}" | tr '[:upper:]' '[:lower:]')"
  case "${ext}" in
    jpg|jpeg|png|heic|webp) return 0 ;;
    *) return 1 ;;
  esac
}

# bg_dir_for <theme> -- prints the theme's backgrounds directory path.
bg_dir_for() {
  printf '%s/%s/backgrounds' "${THEME_DIR}" "$1"
}

# bg_list_images <theme> -- newline-separated, alphabetically sorted list
# of recognised-image basenames in <theme>'s backgrounds dir, or nothing
# if the dir is missing/empty.
bg_list_images() {
  local dir
  dir="$(bg_dir_for "$1")"
  [ -d "${dir}" ] || return 0
  local f name list=""
  shopt -s nullglob
  for f in "${dir}"/*; do
    [ -f "${f}" ] || continue
    name="$(basename "${f}")"
    if bg_is_image_ext "${name}"; then
      list="${list}${name}
"
    fi
  done
  shopt -u nullglob
  [ -n "${list}" ] && printf '%s' "${list}" | sort
}

# bg_read_choice <theme> -- prints the filename recorded for <theme> in
# BACKGROUNDS_STATE_FILE, or nothing if unset/missing/unreadable.
bg_read_choice() {
  [ -f "${BACKGROUNDS_STATE_FILE}" ] || return 0
  python3 -c '
import json, sys

path, theme = sys.argv[1], sys.argv[2]
try:
    with open(path, encoding="utf-8") as fh:
        data = json.load(fh)
except Exception:
    sys.exit(0)
if isinstance(data, dict):
    val = data.get(theme)
    if isinstance(val, str) and val:
        sys.stdout.write(val)
' "${BACKGROUNDS_STATE_FILE}" "$1"
}

# bg_write_choice <theme> <filename> -- atomically records <filename> as
# the chosen background for <theme> in BACKGROUNDS_STATE_FILE, preserving
# every other theme's entry (read-modify-write via a temp file + mv, so a
# reader never sees a partially written file).
bg_write_choice() {
  mkdir -p "$(dirname "${BACKGROUNDS_STATE_FILE}")"
  python3 -c '
import json, os, sys, tempfile

path, theme, filename = sys.argv[1], sys.argv[2], sys.argv[3]
data = {}
if os.path.exists(path):
    try:
        with open(path, encoding="utf-8") as fh:
            loaded = json.load(fh)
        if isinstance(loaded, dict):
            data = loaded
    except Exception:
        data = {}
data[theme] = filename

d = os.path.dirname(path) or "."
fd, tmp = tempfile.mkstemp(prefix=".backgrounds.", suffix=".json", dir=d)
try:
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        json.dump(data, fh, indent=2, sort_keys=True)
        fh.write("\n")
    os.replace(tmp, path)
except Exception:
    os.unlink(tmp)
    raise
' "${BACKGROUNDS_STATE_FILE}" "$1" "$2"
}

# bg_fallback_choice <theme> -- the hook's own fallback: a file named
# default.<ext> if present, else the lexically first recognised image.
# Mirrors tools/hooks/30-wallpaper.sh's own selection so `bg list/current`
# can show the same answer the hook would apply with no recorded choice.
bg_fallback_choice() {
  local dir
  dir="$(bg_dir_for "$1")"
  local f name
  shopt -s nullglob
  for f in "${dir}"/default.*; do
    [ -f "${f}" ] || continue
    name="$(basename "${f}")"
    if bg_is_image_ext "${name}"; then
      printf '%s' "${name}"
      shopt -u nullglob
      return 0
    fi
  done
  for f in "${dir}"/*; do
    [ -f "${f}" ] || continue
    name="$(basename "${f}")"
    if bg_is_image_ext "${name}"; then
      printf '%s' "${name}"
      shopt -u nullglob
      return 0
    fi
  done
  shopt -u nullglob
  return 0
}

# bg_active_choice <theme> -- the background that is (or would be) applied
# for <theme> right now: the recorded choice if it still exists on disk
# and is still a recognised image, else the fallback. Prints nothing if
# the theme has no usable backgrounds at all.
bg_active_choice() {
  local theme="$1" dir recorded
  dir="$(bg_dir_for "${theme}")"
  recorded="$(bg_read_choice "${theme}")"
  if [ -n "${recorded}" ] && [ -f "${dir}/${recorded}" ] && bg_is_image_ext "${recorded}"; then
    printf '%s' "${recorded}"
    return 0
  fi
  bg_fallback_choice "${theme}"
}

# bg_resolve_theme <arg> -- prints <arg> if non-empty, else the current
# theme name; exits 1 with a message if neither is available.
bg_resolve_theme() {
  local theme="$1"
  if [ -z "${theme}" ]; then
    theme="$(theme_current_name)"
  fi
  if [ -z "${theme}" ]; then
    echo "gallery: no current theme set (run 'gallery theme set <name>' first)" >&2
    exit 1
  fi
  if ! valid_id "${theme}"; then
    echo "gallery: invalid theme name: ${theme}" >&2
    exit 1
  fi
  if [ ! -d "${THEME_DIR}/${theme}" ]; then
    echo "gallery: no such theme: ${theme}" >&2
    exit 1
  fi
  printf '%s' "${theme}"
}

# bg_apply_hook <theme> <filename-or-path> -- invokes the installed
# wallpaper hook directly with an explicit override, for instant-apply
# from `bg set/next/prev/apply`. Not gated on the hook being executable
# via THEME_HOOKS_DIR's usual directory scan (theme_set_notify runs every
# hook there on `theme set`/`next`); this calls 30-wallpaper.sh by name
# since it is the only hook that understands backgrounds.
bg_apply_hook() {
  local theme="$1" file="$2"
  local hook="${THEME_HOOKS_DIR}/30-wallpaper.sh"
  if [ ! -x "${hook}" ]; then
    echo "gallery: wallpaper hook not found or not executable: ${hook}" >&2
    return 1
  fi
  "${hook}" "${theme}" "${file}"
}

cmd_bg_list() {
  local theme
  theme="$(bg_resolve_theme "${1:-}")"
  local images
  images="$(bg_list_images "${theme}")"
  if [ -z "${images}" ]; then
    echo "gallery: no backgrounds for theme: ${theme}" >&2
    exit 1
  fi
  local active
  active="$(bg_active_choice "${theme}")"
  local name
  while IFS= read -r name; do
    [ -n "${name}" ] || continue
    if [ "${name}" = "${active}" ] && [ -t 1 ]; then
      printf '%s *\n' "${name}"
    else
      printf '%s\n' "${name}"
    fi
  done <<< "${images}"
}

cmd_bg_current() {
  local theme
  theme="$(bg_resolve_theme "${1:-}")"
  local active
  active="$(bg_active_choice "${theme}")"
  if [ -z "${active}" ]; then
    echo "gallery: theme ${theme} has no backgrounds" >&2
    exit 1
  fi
  echo "${active}"
}

# bg_set_and_maybe_apply <theme> <filename> -- records <filename> as the
# choice for <theme>, then applies it immediately only if <theme> is the
# current theme (an idle theme's wallpaper would have nothing to apply to,
# and applying it would change the live desktop out from under whatever
# theme is actually active).
bg_set_and_maybe_apply() {
  local theme="$1" file="$2"
  bg_write_choice "${theme}" "${file}"
  local current
  current="$(theme_current_name)"
  if [ "${theme}" = "${current}" ]; then
    bg_apply_hook "${theme}" "${file}"
    echo "background: ${file} (${theme})"
  else
    echo "background: ${file} (${theme}, recorded only -- ${theme} is not the current theme)"
  fi
}

cmd_bg_set() {
  local file="${1:?usage: gallery bg set <file> [theme]}"
  local theme
  theme="$(bg_resolve_theme "${2:-}")"

  local base
  base="$(basename "${file}")"
  local dir
  dir="$(bg_dir_for "${theme}")"
  if [ ! -f "${dir}/${base}" ]; then
    echo "gallery: no such background: ${base} (looked in ${dir})" >&2
    exit 1
  fi
  if ! bg_is_image_ext "${base}"; then
    echo "gallery: not a recognised image type: ${base}" >&2
    exit 1
  fi

  bg_set_and_maybe_apply "${theme}" "${base}"
}

# bg_cycle <next|prev> <theme-arg> -- shared implementation for `bg next`/
# `bg prev`: walks the sorted image list once to find the entry before/
# after the current active choice, wrapping at either end.
bg_cycle() {
  local direction="$1"
  local theme
  theme="$(bg_resolve_theme "${2:-}")"

  local images
  images="$(bg_list_images "${theme}")"
  if [ -z "${images}" ]; then
    echo "gallery: no backgrounds for theme: ${theme}" >&2
    exit 1
  fi

  local active
  active="$(bg_active_choice "${theme}")"

  local name last=""
  while IFS= read -r name; do
    [ -n "${name}" ] || continue
    last="${name}"
  done <<< "${images}"

  local target="" first="" prev="" found=0
  if [ "${direction}" = "next" ]; then
    while IFS= read -r name; do
      [ -n "${name}" ] || continue
      [ -z "${first}" ] && first="${name}"
      if [ "${found}" -eq 1 ]; then
        target="${name}"
        break
      fi
      [ "${name}" = "${active}" ] && found=1
    done <<< "${images}"
    [ -n "${target}" ] || target="${first}"
  else
    while IFS= read -r name; do
      [ -n "${name}" ] || continue
      if [ "${name}" = "${active}" ]; then
        found=1
        break
      fi
      prev="${name}"
    done <<< "${images}"
    if [ "${found}" -eq 1 ] && [ -n "${prev}" ]; then
      target="${prev}"
    else
      target="${last}"
    fi
  fi

  bg_set_and_maybe_apply "${theme}" "${target}"
}

cmd_bg_next() {
  bg_cycle next "${1:-}"
}

cmd_bg_prev() {
  bg_cycle prev "${1:-}"
}

cmd_bg_apply() {
  local theme
  theme="$(bg_resolve_theme "${1:-}")"
  local active
  active="$(bg_active_choice "${theme}")"
  if [ -z "${active}" ]; then
    echo "gallery: theme ${theme} has no backgrounds" >&2
    exit 1
  fi
  bg_apply_hook "${theme}" "${active}"
  echo "background: ${active} (${theme})"
}

cmd_bg() {
  local sub="${1:-}"
  [ $# -gt 0 ] && shift
  case "${sub}" in
    list)
      cmd_bg_list "${1:-}"
      ;;
    current)
      cmd_bg_current "${1:-}"
      ;;
    set)
      cmd_bg_set "${1:-}" "${2:-}"
      ;;
    next)
      cmd_bg_next "${1:-}"
      ;;
    prev)
      cmd_bg_prev "${1:-}"
      ;;
    apply)
      cmd_bg_apply "${1:-}"
      ;;
    "")
      echo "usage: gallery bg <list|current|set|next|prev|apply>" >&2
      exit 1
      ;;
    *)
      echo "gallery: unknown bg subcommand: ${sub}" >&2
      exit 1
      ;;
  esac
}

# --- iTerm console mode ------------------------------------------------------
#
# The user's everyday iTerm2 terminal (their "Console" profile, a Dynamic
# Profile child of their own "Default" -- see tools/render-theme.py's
# render_iterm_console_profile for the parent/child mechanism) can either
# follow the active Gallery theme's colours or stay on its own untouched
# Default colours. Recorded in CONSOLE_STATE_FILE as {"mode": "theme"} or
# {"mode": "native"}; missing/invalid means native. Switching modes re-runs
# the renderer, which rewrites gallery-console.json and iTerm picks the
# change up live in already-open Console-profile sessions.

# console_read_mode -- prints "theme" or "native" (default "native" if
# CONSOLE_STATE_FILE is missing, unreadable, or carries anything else).
console_read_mode() {
  if [ ! -f "${CONSOLE_STATE_FILE}" ]; then
    printf 'native'
    return 0
  fi
  python3 -c '
import json, sys

path = sys.argv[1]
mode = "native"
try:
    with open(path, encoding="utf-8") as fh:
        data = json.load(fh)
    if isinstance(data, dict):
        val = data.get("mode")
        if val in ("theme", "native"):
            mode = val
except Exception:
    pass
sys.stdout.write(mode)
' "${CONSOLE_STATE_FILE}"
}

# console_write_mode <mode> -- atomically records "theme" or "native" in
# CONSOLE_STATE_FILE (temp file + os.replace, same pattern as
# bg_write_choice above).
console_write_mode() {
  local mode="$1"
  mkdir -p "$(dirname "${CONSOLE_STATE_FILE}")"
  python3 -c '
import json, os, sys, tempfile

path, mode = sys.argv[1], sys.argv[2]

d = os.path.dirname(path) or "."
fd, tmp = tempfile.mkstemp(prefix=".console.", suffix=".json", dir=d)
try:
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        json.dump({"mode": mode}, fh, indent=2, sort_keys=True)
        fh.write("\n")
    os.replace(tmp, path)
except Exception:
    os.unlink(tmp)
    raise
' "${CONSOLE_STATE_FILE}" "${mode}"
}

cmd_console_status() {
  local mode
  mode="$(console_read_mode)"
  if [ "${mode}" = "theme" ]; then
    echo "console: theme (following $(theme_current_name || true))"
  else
    echo "console: native (iTerm Default profile colours)"
  fi

  local default_guid
  default_guid="$(defaults read com.googlecode.iterm2 "Default Bookmark Guid" 2>/dev/null || true)"
  if [ "${default_guid}" = "gallery-console" ]; then
    echo "default profile: Console (ok)"
  else
    echo "default profile: not Console -- in iTerm2: Settings > Profiles > Console > Other Actions > Set as Default (one-time)"
  fi

  if [ -f "${HOME}/Library/Application Support/iTerm2/DynamicProfiles/gallery-console.json" ]; then
    echo "gallery-console.json: exists"
  else
    echo "gallery-console.json: missing (run: gallery theme render)"
  fi
}

# console_set_mode <theme|native> -- records the mode, then re-renders (which
# rewrites gallery-console.json for the new mode) unless there is no current
# theme to render from, in which case the mode is still recorded but the
# render is skipped and reported as such.
console_set_mode() {
  local mode="$1"
  console_write_mode "${mode}"

  local current
  current="$(theme_current_name)"
  local label
  if [ "${mode}" = "theme" ]; then
    label="theme (following ${current:-no current theme})"
  else
    label="native (iTerm Default profile colours)"
  fi

  if [ -z "${current}" ]; then
    echo "console: ${label} -- render skipped (no current theme set)"
    return 0
  fi

  if ! run_theme_render; then
    echo "gallery: console mode recorded but render failed" >&2
    return 1
  fi
  echo "console: ${label}"
}

cmd_console_theme() {
  console_set_mode theme
}

cmd_console_native() {
  console_set_mode native
}

cmd_console_toggle() {
  local mode
  mode="$(console_read_mode)"
  if [ "${mode}" = "theme" ]; then
    console_set_mode native
  else
    console_set_mode theme
  fi
}

cmd_console() {
  local sub="${1:-}"
  [ $# -gt 0 ] && shift
  case "${sub}" in
    status)
      cmd_console_status
      ;;
    theme)
      cmd_console_theme
      ;;
    native)
      cmd_console_native
      ;;
    toggle)
      cmd_console_toggle
      ;;
    "")
      echo "usage: gallery console <status|theme|native|toggle>" >&2
      exit 1
      ;;
    *)
      echo "gallery: unknown console subcommand: ${sub}" >&2
      exit 1
      ;;
  esac
}

# --- borders (JankyBorders focus-outline prefs) ------------------------------
#
# The focused-window frame (JankyBorders, driven by bin/gallery-borders)
# follows the active theme's colour (Omarchy's own hyprland_active_border
# override when the theme defines one, else accent -- see
# tools/render-theme.py's build_border_tokens), plus two user prefs
# recorded in BORDERS_STATE_FILE as {"width": <1-12>, "bright": bool}:
# missing/invalid means {"width": 5, "bright": false}. Changing either pref
# re-renders (which recomputes GALLERY_BORDER_* in state/theme.sh) and, if
# gallery-borders is installed, applies it to the live daemon immediately --
# same two-step console_set_mode already does for the iTerm console mode.

# borders_read_prefs -- prints two lines: width (bare integer, already
# clamped to 1..12) and bright ("on"/"off"). Same missing-file-means-
# defaults tolerance as console_read_mode.
borders_read_prefs() {
  if [ ! -f "${BORDERS_STATE_FILE}" ]; then
    printf '5\noff\n'
    return 0
  fi
  python3 -c '
import json, sys

path = sys.argv[1]
width = 5
bright = False
try:
    with open(path, encoding="utf-8") as fh:
        data = json.load(fh)
    if isinstance(data, dict):
        w = data.get("width")
        if isinstance(w, int) and not isinstance(w, bool):
            width = max(1, min(12, w))
        b = data.get("bright")
        if isinstance(b, bool):
            bright = b
except Exception:
    pass
print(width)
print("on" if bright else "off")
' "${BORDERS_STATE_FILE}" 2>/dev/null || printf '5\noff\n'
}

# borders_write_prefs <width> <on|off> -- atomically records the prefs in
# BORDERS_STATE_FILE (temp file + os.replace, same pattern as
# console_write_mode).
borders_write_prefs() {
  local width="$1" bright="$2"
  mkdir -p "$(dirname "${BORDERS_STATE_FILE}")"
  python3 -c '
import json, os, sys, tempfile

path = sys.argv[1]
width = int(sys.argv[2])
bright = sys.argv[3] == "on"

d = os.path.dirname(path) or "."
fd, tmp = tempfile.mkstemp(prefix=".borders.", suffix=".json", dir=d)
try:
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        json.dump({"width": width, "bright": bright}, fh, indent=2, sort_keys=True)
        fh.write("\n")
    os.replace(tmp, path)
except Exception:
    os.unlink(tmp)
    raise
' "${BORDERS_STATE_FILE}" "${width}" "${bright}"
}

# borders_apply_and_render -- re-renders the active theme (which recomputes
# GALLERY_BORDER_* from the new prefs) and, if gallery-borders is installed,
# re-invokes it so the live daemon picks the change up immediately, same as
# the theme-set hook (tools/hooks/20-borders.sh) does on a theme change.
borders_apply_and_render() {
  local current
  current="$(theme_current_name)"
  if [ -z "${current}" ]; then
    echo "borders: pref recorded -- render skipped (no current theme set)"
    return 0
  fi

  if ! run_theme_render; then
    echo "gallery: borders pref recorded but render failed" >&2
    return 1
  fi

  local gallery_borders="${HOME}/bin/gallery-borders"
  if [ -x "${gallery_borders}" ]; then
    "${gallery_borders}" apply || echo "gallery: gallery-borders apply failed" >&2
  fi
}

cmd_borders_status() {
  local prefs width bright
  prefs="$(borders_read_prefs)"
  width="$(printf '%s\n' "${prefs}" | sed -n 1p)"
  bright="$(printf '%s\n' "${prefs}" | sed -n 2p)"
  echo "borders: width ${width}, bright ${bright}"

  local theme_colors="${THEME_DIR}/current/colors.toml"
  if [ -f "${theme_colors}" ] && grep -q '^hyprland_active_border[[:space:]]*=' "${theme_colors}"; then
    echo "active border: theme override (hyprland_active_border)"
  else
    echo "active border: theme accent (no hyprland_active_border override)"
  fi
}

cmd_borders_width() {
  local n="${1:-}"
  case "${n}" in
    ''|*[!0-9]*)
      echo "gallery: borders width must be an integer 1-12" >&2
      exit 1
      ;;
  esac
  if [ "${n}" -lt 1 ] || [ "${n}" -gt 12 ]; then
    echo "gallery: borders width must be between 1 and 12" >&2
    exit 1
  fi

  local prefs bright
  prefs="$(borders_read_prefs)"
  bright="$(printf '%s\n' "${prefs}" | sed -n 2p)"

  borders_write_prefs "${n}" "${bright}"
  borders_apply_and_render
  echo "borders: width ${n}"
}

cmd_borders_bright() {
  local mode="${1:-}"
  local prefs width current_bright new_bright
  prefs="$(borders_read_prefs)"
  width="$(printf '%s\n' "${prefs}" | sed -n 1p)"
  current_bright="$(printf '%s\n' "${prefs}" | sed -n 2p)"

  case "${mode}" in
    on) new_bright=on ;;
    off) new_bright=off ;;
    toggle)
      if [ "${current_bright}" = "on" ]; then
        new_bright=off
      else
        new_bright=on
      fi
      ;;
    *)
      echo "usage: gallery borders bright <on|off|toggle>" >&2
      exit 1
      ;;
  esac

  borders_write_prefs "${width}" "${new_bright}"
  borders_apply_and_render
  echo "borders: bright ${new_bright}"
}

cmd_borders() {
  local sub="${1:-}"
  [ $# -gt 0 ] && shift
  case "${sub}" in
    status)
      cmd_borders_status
      ;;
    width)
      cmd_borders_width "${1:-}"
      ;;
    bright)
      cmd_borders_bright "${1:-}"
      ;;
    "")
      echo "usage: gallery borders <status|width <1-12>|bright <on|off|toggle>>" >&2
      exit 1
      ;;
    *)
      echo "gallery: unknown borders subcommand: ${sub}" >&2
      exit 1
      ;;
  esac
}

find_render_tool() {
  if [ -f "${RENDER_TOOL_INSTALLED}" ]; then
    printf '%s\n' "${RENDER_TOOL_INSTALLED}"
  elif [ -f "${RENDER_TOOL_REPO}" ]; then
    printf '%s\n' "${RENDER_TOOL_REPO}"
  else
    return 1
  fi
}

run_theme_render() {
  local tool
  if ! tool="$(find_render_tool)"; then
    echo "gallery: render-theme.py not found (installed under ${RENDER_TOOL_INSTALLED} or in a repo checkout); run install.sh" >&2
    return 1
  fi
  command -v python3 >/dev/null 2>&1 || { echo "gallery: python3 not found on PATH" >&2; return 1; }
  python3 "${tool}"
}

# theme_set_notify <name> -- runs the renderers, every executable hook in
# THEME_HOOKS_DIR (in name order, with the theme name as $1), then asks
# Hammerspoon to reload the theme over IPC. Used by both `theme set` and
# `theme next`.
theme_set_notify() {
  local name="$1"

  if ! run_theme_render; then
    echo "gallery: theme renderers failed for ${name}" >&2
  fi

  if [ -d "${THEME_HOOKS_DIR}" ]; then
    local hook
    for hook in "${THEME_HOOKS_DIR}"/*; do
      [ -f "${hook}" ] && [ -x "${hook}" ] || continue
      echo "running hook: $(basename "${hook}")"
      if ! "${hook}" "${name}"; then
        echo "gallery: hook failed: $(basename "${hook}")" >&2
      fi
    done
  fi

  local rout
  if rout="$(ipc_call theme-reload)"; then
    case "${rout}" in
      "unknown verb:"*)
        echo "gallery: Spoon does not yet support 'theme-reload' -- skipping (${rout})" >&2
        ;;
      *)
        printf '%s\n' "${rout}"
        ;;
    esac
  else
    echo "gallery: failed to reach Hammerspoon for theme-reload" >&2
  fi
}

cmd_theme_list() {
  local current names
  current="$(theme_current_name)"
  names="$(theme_names)"
  if [ -z "${names}" ]; then
    echo "no themes installed"
    return 0
  fi
  local name marker line
  while IFS= read -r name; do
    [ -n "${name}" ] || continue
    marker=""
    if [ "${name}" = "${current}" ]; then
      marker="current"
    fi
    if theme_is_light "${THEME_DIR}/${name}"; then
      if [ -n "${marker}" ]; then marker="${marker}, light"; else marker="light"; fi
    fi
    if [ -n "${marker}" ]; then
      line="${name} (${marker})"
    else
      line="${name}"
    fi
    printf '%s\n' "${line}"
  done <<< "${names}"
}

cmd_theme_current() {
  local current
  current="$(theme_current_name)"
  if [ -z "${current}" ]; then
    echo "gallery: no current theme set (run 'gallery theme set <name>')" >&2
    exit 1
  fi
  echo "${current}"
}

cmd_theme_set() {
  local name="${1:?usage: gallery theme set <name>}"
  if ! valid_id "${name}"; then
    echo "gallery: invalid theme name: ${name}" >&2
    exit 1
  fi

  local dir="${THEME_DIR}/${name}"
  if [ ! -d "${dir}" ]; then
    echo "gallery: no such theme: ${name} (looked in ${dir})" >&2
    exit 1
  fi
  if [ ! -f "${dir}/colors.toml" ]; then
    echo "gallery: theme ${name} has no colors.toml" >&2
    exit 1
  fi

  mkdir -p "${THEME_DIR}"

  # Atomic replace: symlink a temp name, then mv it over `current`, so there
  # is never a moment with a missing or half-written `current` link. -h is
  # required here: plain `mv -f` treats an existing `current` that is itself
  # a symlink to a directory as that directory and moves the temp link
  # *inside* it instead of replacing the `current` link (a BSD/macOS mv
  # quirk); -h tells mv not to follow `current` and replace it in place.
  local tmp_link
  tmp_link="$(mktemp -u "${THEME_DIR}/.current.XXXXXXXX")"
  ln -s "${name}" "${tmp_link}"
  mv -fh "${tmp_link}" "${THEME_DIR}/current"

  echo "theme set: ${name}"
  theme_set_notify "${name}"
}

cmd_theme_render() {
  local current
  current="$(theme_current_name)"
  if [ -z "${current}" ]; then
    echo "gallery: no current theme set (run 'gallery theme set <name>' first)" >&2
    exit 1
  fi
  run_theme_render
}

cmd_theme_next() {
  local current names
  current="$(theme_current_name)"
  names="$(theme_names)"
  if [ -z "${names}" ]; then
    echo "gallery: no themes installed" >&2
    exit 1
  fi

  local name prev="" next="" first_name=""
  while IFS= read -r name; do
    [ -n "${name}" ] || continue
    [ -z "${first_name}" ] && first_name="${name}"
    if [ "${prev}" = "${current}" ]; then
      next="${name}"
      break
    fi
    prev="${name}"
  done <<< "${names}"

  if [ -z "${next}" ]; then
    next="${first_name}"
  fi

  cmd_theme_set "${next}"
}

cmd_theme() {
  local sub="${1:-}"
  [ $# -gt 0 ] && shift
  case "${sub}" in
    list)
      cmd_theme_list
      ;;
    current)
      cmd_theme_current
      ;;
    set)
      cmd_theme_set "${1:-}"
      ;;
    render)
      cmd_theme_render
      ;;
    next)
      cmd_theme_next
      ;;
    "")
      echo "usage: gallery theme <list|current|set|render|next>" >&2
      exit 1
      ;;
    *)
      echo "gallery: unknown theme subcommand: ${sub}" >&2
      exit 1
      ;;
  esac
}

cmd_reload() {
  require_hs
  # Reload via the init.lua pathwatcher (debounced in init.lua); asking over IPC
  # can hang the client when the reload cuts the conversation.
  touch "${HOME}/.hammerspoon/init.lua" && echo "reload requested (watch ~/Library/Logs/gallery.log)"
}

cmd_log() {
  touch "${LOG_FILE}"
  tail -f "${LOG_FILE}"
}

cmd_doctor() {
  local ok=1

  if [ -d "/Applications/Hammerspoon.app" ]; then
    echo "OK      Hammerspoon.app present"
  else
    echo "MISSING Hammerspoon.app present"
    ok=0
  fi

  if pgrep -x "Hammerspoon" >/dev/null 2>&1; then
    echo "OK      Hammerspoon running"
  else
    echo "MISSING Hammerspoon running"
    ok=0
  fi

  if command -v hs >/dev/null 2>&1; then
    echo "OK      hs CLI on PATH"
  else
    echo "MISSING hs CLI on PATH"
    ok=0
  fi

  if command -v git >/dev/null 2>&1; then
    echo "OK      git on PATH"
  else
    echo "MISSING git on PATH"
    ok=0
  fi

  if command -v python3 >/dev/null 2>&1; then
    echo "OK      python3 on PATH"
  else
    echo "MISSING python3 on PATH"
    ok=0
  fi

  if [ -d "${HOME}/.hammerspoon/Spoons/Gallery.spoon" ]; then
    echo "OK      Gallery.spoon installed"
  else
    echo "MISSING Gallery.spoon installed"
    ok=0
  fi

  if [ -d "${PLUGIN_DIR}" ]; then
    echo "OK      ${PLUGIN_DIR} exists"
  else
    echo "MISSING ${PLUGIN_DIR} exists"
    ok=0
  fi

  if [ -f "${GALLERY_JSON}" ]; then
    echo "OK      ${GALLERY_JSON} exists"
  else
    echo "MISSING ${GALLERY_JSON} exists (informational; written once the Spoon persists state)"
  fi

  # tui/menu kind plugins run in iTerm2 via gallery-tui, no Hammerspoon
  # involved -- checked here regardless of whether any installed plugin
  # currently uses those kinds.
  if [ -d "/Applications/iTerm.app" ]; then
    echo "OK      iTerm2.app present"
  else
    echo "MISSING iTerm2.app present"
    ok=0
  fi

  local gallery_tui
  gallery_tui="$(resolve_helper_bin gallery-tui)"
  if [ -x "${gallery_tui}" ]; then
    echo "OK      gallery-tui installed (${gallery_tui})"
  else
    echo "MISSING gallery-tui installed"
    ok=0
  fi

  # fzf/glow/btop are used by individual tui/menu plugins (the menu kind's
  # fzf runner, and common tui commands) but are not required by Gallery
  # itself -- warn, do not fail.
  if command -v fzf >/dev/null 2>&1; then
    echo "OK      fzf on PATH"
  else
    echo "WARN    fzf on PATH (needed by menu-kind plugins; brew install fzf)"
  fi

  if command -v glow >/dev/null 2>&1; then
    echo "OK      glow on PATH"
  else
    echo "WARN    glow on PATH (used by some tui-kind plugins; brew install glow)"
  fi

  if command -v btop >/dev/null 2>&1; then
    echo "OK      btop on PATH"
  else
    echo "WARN    btop on PATH (used by some tui-kind plugins; brew install btop)"
  fi

  if command -v hs >/dev/null 2>&1; then
    if [ "$(hs_call "return hs.accessibilityState()" 2>/dev/null)" = "true" ]; then
      echo "OK      Accessibility granted"
    else
      echo "MISSING Accessibility granted"
      ok=0
    fi
  else
    echo "MISSING Accessibility granted (cannot check without hs CLI)"
    ok=0
  fi

  local login_items
  if login_items="$(osascript -e 'tell application "System Events" to get name of every login item' 2>/dev/null)"; then
    if [[ "${login_items}" == *"Hammerspoon"* ]]; then
      echo "OK      Hammerspoon is a login item"
    else
      echo "WARN    Hammerspoon is a login item"
    fi
  else
    echo "WARN    Hammerspoon is a login item (osascript error)"
  fi

  # tiler (yabai + skhd): installed by tiler/install.sh, run as the first
  # step of this repo's own install.sh (unless --skip-tiler).
  if command -v yabai >/dev/null 2>&1; then
    echo "OK      yabai on PATH"
  else
    echo "MISSING yabai on PATH"
    ok=0
  fi

  if pgrep -xq yabai; then
    echo "OK      yabai running"
  else
    echo "MISSING yabai running"
    ok=0
  fi

  if command -v skhd >/dev/null 2>&1; then
    echo "OK      skhd on PATH"
  else
    echo "MISSING skhd on PATH"
    ok=0
  fi

  if pgrep -xq skhd; then
    echo "OK      skhd running"
  else
    echo "MISSING skhd running"
    ok=0
  fi

  if [ -f "${HOME}/.config/skhd/skhdrc" ]; then
    echo "OK      ${HOME}/.config/skhd/skhdrc exists"
  else
    echo "MISSING ${HOME}/.config/skhd/skhdrc exists (run tiler/install.sh)"
    ok=0
  fi

  if pgrep -x skhd >/dev/null 2>&1 \
    && grep -q '\.load "gallery\.skhd"' "${HOME}/.config/skhd/skhdrc" 2>/dev/null \
    && [ -f "${HOME}/.config/skhd/gallery.skhd" ]; then
    echo "OK      skhd running with gallery.skhd loaded"
  else
    echo "WARN    skhd running with gallery.skhd loaded (run the tiler installer)"
  fi

  if command -v yabai >/dev/null 2>&1; then
    local yabai_windows
    if yabai_windows="$(yabai -m query --windows 2>/dev/null)"; then
      if command -v python3 >/dev/null 2>&1; then
        local yabai_status
        yabai_status="$(printf '%s' "${yabai_windows}" | python3 -c '
import json, sys
try:
    data = json.load(sys.stdin)
except Exception:
    print("parse-error")
    sys.exit(0)
if not isinstance(data, list) or len(data) < 1:
    print("no-windows")
    sys.exit(0)
if any(isinstance(w, dict) and w.get("has-ax-reference") is True for w in data):
    print("ok")
else:
    print("blind")
' 2>/dev/null)"
        case "${yabai_status}" in
          ok)
            echo "OK      yabai has accessibility references"
            ;;
          blind)
            echo "FAIL    yabai is blind (no accessibility references) -- dismiss any pending accessibility prompt, then: launchctl kickstart -k gui/501/com.asmvik.yabai"
            ok=0
            ;;
          no-windows)
            echo "WARN    yabai has accessibility references (no windows to check)"
            ;;
          *)
            echo "WARN    yabai has accessibility references (unexpected output from yabai -m query --windows)"
            ;;
        esac
      else
        echo "WARN    yabai has accessibility references (python3 not found to parse output)"
      fi
    else
      echo "WARN    yabai has accessibility references (yabai not running)"
    fi
  else
    echo "WARN    yabai has accessibility references (yabai not installed)"
  fi

  local theme_current_link="${THEME_DIR}/current"
  if [ -L "${theme_current_link}" ] && [ -f "${theme_current_link}/colors.toml" ]; then
    echo "OK      gallery theme 'current' resolves to a theme with colors.toml"
  else
    echo "WARN    gallery theme 'current' resolves to a theme with colors.toml"
  fi

  if [ -f "${HOME}/Library/Application Support/iTerm2/DynamicProfiles/gallery-theme.json" ]; then
    echo "OK      iTerm2 dynamic profile gallery-theme.json exists"
  else
    echo "WARN    iTerm2 dynamic profile gallery-theme.json exists (run: gallery theme render)"
  fi

  if [ -f "${HOME}/Library/Application Support/iTerm2/DynamicProfiles/gallery-console.json" ]; then
    echo "OK      iTerm2 dynamic profile gallery-console.json exists"
  else
    echo "WARN    iTerm2 dynamic profile gallery-console.json exists (run: gallery theme render)"
  fi

  if [ -f "${BORDERS_STATE_FILE}" ]; then
    echo "OK      gallery/state/borders.json exists"
  else
    echo "WARN    gallery/state/borders.json exists (absent -- defaults: width 5, bright off)"
  fi

  # qml kind: the shim host and its venv are set up on first run of any qml
  # plugin (or `gallery-qml --setup`), not by install.sh -- see install.sh's
  # own comment on why. Their absence is a WARN, not a failure: a Mac that
  # never runs a qml plugin does not need any of this.
  local qml_host="${CONFIG_DIR}/qml/host.py"
  if [ -f "${qml_host}" ]; then
    echo "OK      ${qml_host} exists"
  else
    echo "WARN    ${qml_host} exists (run install.sh, then any qml plugin once)"
  fi

  local qml_venv_py="${CONFIG_DIR}/qml-venv/bin/python3"
  if [ -x "${qml_venv_py}" ]; then
    if "${qml_venv_py}" -c 'import PySide6' >/dev/null 2>&1; then
      echo "OK      qml-venv can import PySide6"
    else
      echo "WARN    qml-venv can import PySide6 (venv exists but PySide6 is missing)"
    fi
  else
    echo "WARN    qml-venv python exists (first run creates it: gallery toggle <a qml plugin>, or gallery-qml --setup)"
  fi

  local omarchy_theme_link="${HOME}/.config/omarchy/current/theme"
  if [ -e "${omarchy_theme_link}" ]; then
    echo "OK      ${omarchy_theme_link} resolves"
  else
    echo "WARN    ${omarchy_theme_link} resolves (run install.sh)"
  fi

  if [ "${ok}" -eq 1 ]; then
    exit 0
  else
    exit 1
  fi
}

cmd_install() {
  local candidate="${SCRIPT_DIR}/../install.sh"
  if [ -f "${candidate}" ]; then
    exec "${candidate}"
  else
    echo "gallery: install.sh not found relative to this script." >&2
    echo "gallery: run install.sh from your clone of the-gallery repo." >&2
    exit 1
  fi
}

if [ $# -lt 1 ]; then
  usage
  exit 1
fi

command="$1"
shift

case "${command}" in
  status)
    cmd_status
    ;;
  list)
    cmd_list "${1:-}"
    ;;
  open)
    cmd_open "${1:-}" "${2:-}"
    ;;
  close)
    cmd_close "${1:-}" "${2:-}"
    ;;
  toggle)
    cmd_toggle "${1:-}" "${2:-}"
    ;;
  enable)
    cmd_enable "${1:-}"
    ;;
  disable)
    cmd_disable "${1:-}"
    ;;
  add)
    cmd_add "$@"
    ;;
  update)
    cmd_update "${1:-}"
    ;;
  remove)
    cmd_remove "$@"
    ;;
  clone)
    cmd_clone "${1:-}" "${2:-}"
    ;;
  patch)
    cmd_patch "${1:-}"
    ;;
  validate)
    cmd_validate "${1:-}"
    ;;
  theme)
    cmd_theme "$@"
    ;;
  bg)
    cmd_bg "$@"
    ;;
  console)
    cmd_console "$@"
    ;;
  borders)
    cmd_borders "$@"
    ;;
  reload)
    cmd_reload
    ;;
  log)
    cmd_log
    ;;
  doctor)
    cmd_doctor
    ;;
  install)
    cmd_install
    ;;
  *)
    usage
    exit 1
    ;;
esac
