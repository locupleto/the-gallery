#!/usr/bin/env bash
#
# gallery-agent -- launch the default coding agent, modelled on Omarchy 4's
# omarchy-agent (/usr/share/omarchy/bin/omarchy-agent).
#
#   gallery-agent            open the agent in a new terminal window
#   gallery-agent inline     run the agent in the current terminal
#   gallery-agent status     which agent is default, where it starts, is it installed
#   gallery-agent list       the supported agents and whether each is on PATH
#   gallery-agent set <name> record the default agent
#   gallery-agent dir [<path>|--clear]
#                            show, record or forget the start directory
#
# Two doors, both ending here: the `gallery agent` CLI verb and
# shift+ctrl+super+a in skhd/gallery.skhd.
#
# AN ORDINARY WINDOW, TILED. Omarchy's launcher ends in `omarchy-launch-tui
# --app-id=org.omarchy.agent`, and that script is nothing but
# `xdg-terminal-exec --app-id=... -e <command>` -- a plain terminal window.
# The app-id exists so rules and themes CAN single the agent out; no Omarchy
# rule floats it (only org.omarchy.about and the screensaver float), so
# Hyprland tiles it with everything else. This does the same: a new window of the
# configured terminal (gallery-term), tiled by yabai. It is deliberately NOT a gallery-tui surface --
# floating and centred is right for btop and Learn, which are glanced at and
# dismissed, and wrong for a window that is worked in for an hour beside an
# editor. As in Omarchy, a second keypress opens a SECOND agent rather than
# focusing the first: one per repo, one per task (decided
# after the first cut shipped it as a floating tui plugin).
#
# THE START DIRECTORY. Omarchy cds to $HOME/Work before launching, because an
# agent will not remember a trust decision for $HOME and would re-ask on every
# session. Point the agent at the directory holding your repos and one trust
# approval covers all of them: `gallery agent dir <path>` records it per
# machine in the state file, GALLERY_AGENT_DIR overrides that, and with
# neither the agent starts in $HOME. It applies however the agent is
# launched (chosen over Omarchy's "only when PWD is $HOME" rule); a
# directory that has gone missing -- e.g. on an external volume -- falls
# back to $HOME with a warning rather than failing to launch.
#
# PERMISSIONS. Each agent is started with its own spelling of "do not stop to
# ask", exactly as omarchy-agent does: a keypress-launched agent that sits
# waiting for an approval it cannot show is useless. This is a deliberate
# posture, not an oversight -- the agent has full file and shell access,
# unattended, in the start directory above.
set -euo pipefail

CONFIG_DIR="${GALLERY_CONFIG_DIR:-${HOME}/.config/gallery}"
STATE_FILE="${CONFIG_DIR}/state/agent.json"
DEFAULT_AGENT="claude"

# This script's own absolute path: the window opened below runs it again with
# `launch`, and the copy that opened the window is the copy that should run --
# a repo checkout under test must not hand off to the installed one.
SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"

# The supported agents and the flag each one needs to run unattended. Kept in
# the same order as Omarchy's own case statement so the two can be compared.
agent_command() {
  case "$1" in
    claude)   printf '%s\n' claude --permission-mode bypassPermissions ;;
    gemini)   printf '%s\n' gemini --yolo ;;
    opencode) printf '%s\n' opencode --auto ;;
    codex)    printf '%s\n' codex --dangerously-bypass-approvals-and-sandbox ;;
    copilot)  printf '%s\n' copilot --allow-all ;;
    crush)    printf '%s\n' crush --yolo ;;
    *) return 1 ;;
  esac
}

SUPPORTED="claude gemini opencode codex copilot crush"

die() { echo "gallery agent: $*" >&2; exit 1; }

# The value of one "key": "value" pair in the state file, or nothing.
state_value() {
  [ -f "${STATE_FILE}" ] || return 0
  sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" "${STATE_FILE}" | head -1
}

# Rewrite the state file with both keys; an empty dir is left out.
write_state() {
  mkdir -p "$(dirname "${STATE_FILE}")"
  if [ -n "$2" ]; then
    printf '{\n  "agent": "%s",\n  "dir": "%s"\n}\n' "$1" "$2" > "${STATE_FILE}.new"
  else
    printf '{\n  "agent": "%s"\n}\n' "$1" > "${STATE_FILE}.new"
  fi
  mv -f "${STATE_FILE}.new" "${STATE_FILE}"
}

current_agent() {
  local a
  a="$(state_value agent)"
  printf '%s\n' "${a:-${DEFAULT_AGENT}}"
}

start_dir() {
  local d="${GALLERY_AGENT_DIR:-$(state_value dir)}"
  d="${d:-${HOME}}"
  if [ -d "${d}" ]; then
    printf '%s\n' "${d}"
  else
    echo "gallery agent: ${d} is not reachable, starting in ${HOME}" >&2
    printf '%s\n' "${HOME}"
  fi
}

# A new terminal window running this script's `launch` verb.
#
# The window's command is a LOGIN shell (`zsh -l`), not the agent binary
# directly: the terminal inherits launchd's PATH, which has neither Homebrew nor the
# node prefixes on it, so `claude` would not be found. `-l` is enough -- it
# sources .zprofile, where brew shellenv sets PATH -- and it is deliberately
# not `-i`: an interactive shell would also source .zshrc for nothing.
#
# The script path is passed as $0 rather than interpolated into the quoted
# command, so a path containing spaces or quotes cannot break out of it.
open_window() {
  local script="$1"
  local command="/bin/zsh -l -c 'exec \"\$0\" launch' \"${script}\""
  # Test seam: tests/agent_test.sh asserts on the command without ever
  # opening a window (see the login-shell note above -- it is the one part
  # of this that is easy to get subtly wrong).
  if [ -n "${GALLERY_AGENT_PRINT_COMMAND:-}" ]; then
    printf '%s\n' "${command}"
    return 0
  fi
  # A tiled window of the configured terminal, opened by gallery-term (cold
  # start included: it launches and waits for iTerm2 and Ghostty first, which
  # are not ready for AppleScript immediately). On iTerm2 it prints the new
  # window's id; the other terminals print nothing and go without the
  # Space check below.
  local term wid
  term="${GALLERY_TERM_BIN:-$(dirname "${SELF}")/gallery-term}"
  [ -x "${term}" ] || term="${HOME}/bin/gallery-term"
  wid="$("${term}" open --role tile -- /bin/zsh -l -c 'exec "$0" launch' "${script}")" || return 0
  case "${wid}" in ''|*[!0-9]*) return 0 ;; esac
  keep_on_current_space "${wid}"
}

# keep_on_current_space <window id> -- moves the new window to the Space the
# user is looking at, if macOS put it somewhere else.
#
# Pressing the key straight after switching Spaces (super+2, or ctrl+2 itself)
# lands inside the ~0.5 s switch animation, and a window created then can be
# placed on the Space being LEFT: the key looks dead on the new Space while
# the agent quietly opens on the old one (2026-10-01, seen once, not
# reproducible on demand -- which is what a race looks like). The reference
# is therefore the Space in view once the window exists and the switch has
# settled, not the one captured at key press: mid-animation, yabai can still
# report the old Space as focused.
#
# iTerm's AppleScript window id is the CGWindowID yabai uses, so the two can
# be compared directly. Skipped silently whenever yabai is absent or never
# sees the window (the AX-less windows plugins/gallery.ghosts exists for);
# this only ever corrects a misplaced window, it never blocks one opening.
keep_on_current_space() {
  local wid="$1" win_space="" view_space="" waited=0
  [ -n "${wid}" ] && command -v yabai >/dev/null 2>&1 || return 0
  # yabai learns of the window a moment after iTerm creates it.
  while [ -z "${win_space}" ] && [ "${waited}" -lt 20 ]; do
    win_space="$(yabai -m query --windows --window "${wid}" 2>/dev/null \
      | sed -n 's/^[[:space:]]*"space":[[:space:]]*\([0-9][0-9]*\).*/\1/p' | head -1)"
    [ -n "${win_space}" ] && break
    sleep 0.1
    waited=$((waited + 1))
  done
  [ -n "${win_space}" ] || return 0
  view_space="$(yabai -m query --spaces --space 2>/dev/null \
    | sed -n 's/^[[:space:]]*"index":[[:space:]]*\([0-9][0-9]*\).*/\1/p' | head -1)"
  [ -n "${view_space}" ] && [ "${win_space}" != "${view_space}" ] || return 0
  yabai -m window "${wid}" --space "${view_space}" >/dev/null 2>&1 || return 0
  yabai -m window "${wid}" --focus >/dev/null 2>&1 || true
}

case "${1:-open}" in
  list)
    for a in ${SUPPORTED}; do
      if command -v "$a" >/dev/null 2>&1; then mark="installed"; else mark="-"; fi
      [ "$a" = "$(current_agent)" ] && mark="${mark} (default)"
      printf '%-10s %s\n' "$a" "${mark}"
    done
    ;;
  status)
    a="$(current_agent)"
    printf 'agent:   %s%s\n' "$a" "$(command -v "$a" >/dev/null 2>&1 || echo ' (NOT INSTALLED)')"
    printf 'starts:  %s\n' "$(start_dir 2>/dev/null)"
    printf 'command: %s\n' "$(agent_command "$a" 2>/dev/null | tr '\n' ' ')"
    printf 'state:   %s\n' "${STATE_FILE}"
    ;;
  set)
    name="${2:?usage: gallery agent set <name>}"
    agent_command "${name}" >/dev/null 2>&1 || die "unsupported agent: ${name} (one of: ${SUPPORTED})"
    command -v "${name}" >/dev/null 2>&1 || echo "gallery agent: warning -- ${name} is not on PATH" >&2
    write_state "${name}" "$(state_value dir)"
    echo "default agent: ${name}"
    ;;
  dir)
    case "${2:-}" in
      "") start_dir ;;
      --clear)
        write_state "$(current_agent)" ""
        echo "start directory: \$HOME (GALLERY_AGENT_DIR still overrides)"
        ;;
      *)
        [ -d "$2" ] || die "not a directory: $2"
        d="$(cd "$2" && pwd)"
        write_state "$(current_agent)" "${d}"
        echo "start directory: ${d}"
        ;;
    esac
    ;;
  open)
    # Checked here as well as in `launch`, so a missing agent is reported in
    # the terminal the key was pressed from instead of in a window that
    # opens and closes again before it can be read.
    a="$(current_agent)"
    command -v "$a" >/dev/null 2>&1 || die "${a} is not installed (gallery agent list)"
    open_window "${SELF}"
    ;;
  inline|launch)
    a="$(current_agent)"
    command -v "$a" >/dev/null 2>&1 || die "${a} is not installed (gallery agent list)"
    # Read the command into an array before the cd, so a failure here is
    # reported from a known directory.
    cmd=()
    while IFS= read -r part; do cmd+=("$part"); done < <(agent_command "$a")
    cd "$(start_dir)"
    exec "${cmd[@]}"
    ;;
  *)
    die "usage: gallery agent [open|inline|status|list|set <name>]"
    ;;
esac
