#!/usr/bin/env bash
#
# gallery-agent -- launch the default coding agent, modelled on Omarchy 4's
# omarchy-agent (/usr/share/omarchy/bin/omarchy-agent).
#
#   gallery-agent [open [<name>]]
#                            open the default agent (or <name>, once) in a new
#                            terminal window
#   gallery-agent inline [<name>]
#                            run the default agent (or <name>) in this terminal
#   gallery-agent status     which agent is default, where it starts, is it installed
#   gallery-agent list       every agent, whether each is on PATH, which is default
#   gallery-agent set <name> record the default agent
#   gallery-agent set <name> --command "<command line>"
#                            use any other agent CLI as the default (see CUSTOM AGENTS)
#   gallery-agent add <name> --command "<command line>"
#                            register another agent without making it the default
#   gallery-agent remove <name>
#                            forget a registered agent
#   gallery-agent dir [<path>|--clear]
#                            show, record or forget the start directory
#
# Two doors, both ending here: the `gallery agent` CLI verb and
# shift+ctrl+super+a in skhd/gallery.skhd.
#
# AN ORDINARY WINDOW, TILED. Omarchy's launcher ends in `omarchy-launch-tui
# --app-id=org.omarchy.agent`, and that script is nothing but
# `xdg-terminal-exec --app-id=... -e <command>` -- a plain terminal window.
# The app-id exists so rules and themes CAN single the agent out; no Omarchy
# rule floats it (only org.omarchy.about and the screensaver float), so
# Hyprland tiles it with everything else. This does the same: a new window of the
# configured terminal (gallery-term), tiled by yabai. It is deliberately NOT a gallery-tui surface --
# floating and centred is right for btop and Learn, which are glanced at and
# dismissed, and wrong for a window that is worked in for an hour beside an
# editor. As in Omarchy, a second keypress opens a SECOND agent rather than
# focusing the first: one per repo, one per task (decided
# after the first cut shipped it as a floating tui plugin).
#
# THE START DIRECTORY. Omarchy cds to $HOME/Work before launching, because an
# agent will not remember a trust decision for $HOME and would re-ask on every
# session. Point the agent at the directory holding your repos and one trust
# approval covers all of them: `gallery agent dir <path>` records it per
# machine in the state file, GALLERY_AGENT_DIR overrides that, and with
# neither the agent starts in $HOME. It applies however the agent is
# launched (chosen over Omarchy's "only when PWD is $HOME" rule); a
# directory that has gone missing -- e.g. on an external volume -- falls
# back to $HOME with a warning rather than failing to launch.
#
# CUSTOM AGENTS. The built-ins below are only the agents Omarchy knows. Any other
# CLI works through `set <name> --command "<command line>"`, which records the
# line as "command" in the state file next to "agent". The line is run by a
# shell (so quoting works), after the cd, as `exec <command line>`: put the
# program first and its arguments, including its own "do not ask" flag, after it.
# The state file is written by plain printf and read back by sed, so the line may
# not contain a double quote, a backslash or a newline -- `set` refuses those
# (use single quotes inside the line). `set <built-in>` without --command goes
# back to that built-in's own command.
#
# SEVERAL AGENTS. One agent is the default: the key and a bare `open` start it.
# Any other is started by name, once, with `open <name>` (or bound to a key of
# its own in local.skhd); the default does not change. A built-in needs no
# setup for that. A custom one is registered with `add <name> --command
# "<line>"`, which writes the line to AGENTS_DIR/<name> -- one file per agent,
# one line each, for the same reason the state file is plain printf/sed.
# `set <name> --command` records the default's line in the state file as
# before and registers it too, so a custom agent stays available by name
# after another becomes the default; `set <registered name>` makes it the
# default again. A registered line for a built-in name overrides that
# built-in's command; `set <built-in>` without --command drops the override,
# as it always has.
#
# PERMISSIONS. Each agent is started with its own spelling of "do not stop to
# ask", exactly as omarchy-agent does: a keypress-launched agent that sits
# waiting for an approval it cannot show is useless. This is a deliberate
# posture, not an oversight -- the agent has full file and shell access,
# unattended, in the start directory above.
set -euo pipefail

CONFIG_DIR="${GALLERY_CONFIG_DIR:-${HOME}/.config/gallery}"
STATE_FILE="${CONFIG_DIR}/state/agent.json"
AGENTS_DIR="${CONFIG_DIR}/state/agents"
DEFAULT_AGENT="claude"

# This script's own absolute path: the window opened below runs it again with
# `launch`, and the copy that opened the window is the copy that should run --
# a repo checkout under test must not hand off to the installed one.
SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"

# The supported agents and the flag each one needs to run unattended. Kept in
# the same order as Omarchy's own case statement so the two can be compared.
agent_command() {
  case "$1" in
    claude)   printf '%s\n' claude --permission-mode bypassPermissions ;;
    gemini)   printf '%s\n' gemini --yolo ;;
    opencode) printf '%s\n' opencode --auto ;;
    codex)    printf '%s\n' codex --dangerously-bypass-approvals-and-sandbox ;;
    copilot)  printf '%s\n' copilot --allow-all ;;
    crush)    printf '%s\n' crush --yolo ;;
    *) return 1 ;;
  esac
}

SUPPORTED="claude gemini opencode codex copilot crush"

die() { echo "gallery agent: $*" >&2; exit 1; }

# A custom command line (see CUSTOM AGENTS) for the current agent, or nothing.
custom_command() { state_value command; }

# The custom command line of agent $1, or nothing: the default agent's line
# from the state file, else a line registered in AGENTS_DIR (see SEVERAL
# AGENTS).
custom_line() {
  local c=""
  [ "$1" = "$(state_value agent)" ] && c="$(custom_command)"
  if [ -z "${c}" ] && [ -f "${AGENTS_DIR}/$1" ]; then
    c="$(head -n 1 "${AGENTS_DIR}/$1")"
  fi
  printf '%s' "${c}"
}

# The command line of agent $1 as one string: its custom line if it has one,
# else the built-in's. Fails for a name that is neither.
agent_line() {
  local c
  c="$(custom_line "$1")"
  if [ -n "${c}" ]; then
    printf '%s\n' "${c}"
  else
    agent_command "$1" | tr '\n' ' ' | sed 's/ $//'
  fi
}

# known_agent <name> -- a built-in, or a custom agent with a recorded line.
known_agent() {
  agent_command "$1" >/dev/null 2>&1 || [ -n "$(custom_line "$1")" ]
}

# valid_name <name> -- the characters an agent name may use. Names end up in a
# file name and in the window's command, so nothing else gets through.
valid_name() {
  case "$1" in ''|*[!A-Za-z0-9._-]*) return 1 ;; esac
}

# check_line <line> -- refuses what the plain-text state cannot hold (see
# CUSTOM AGENTS), or a line with no program in it.
check_line() {
  [ -n "${1//[[:space:]]/}" ] || return 1
  case "$1" in
    *\"*|*\\*|*$'\n'*|*$'\r'*) die "the command may not contain double quotes, backslashes or newlines (use single quotes inside it)" ;;
  esac
}

# register <name> <line> -- write a custom agent's line to AGENTS_DIR.
register() {
  mkdir -p "${AGENTS_DIR}"
  printf '%s\n' "$2" > "${AGENTS_DIR}/$1.new"
  mv -f "${AGENTS_DIR}/$1.new" "${AGENTS_DIR}/$1"
}

# warn_if_missing <line> -- the "not on PATH" warning for a line's program.
warn_if_missing() {
  local prog="${1#"${1%%[![:space:]]*}"}"
  prog="${prog%%[[:space:]]*}"
  command -v "${prog}" >/dev/null 2>&1 || echo "gallery agent: warning -- ${prog} is not on PATH" >&2
}

# The program (first word) of agent $1's command line, for the on-PATH check.
agent_program() {
  local line
  line="$(agent_line "$1" 2>/dev/null)" || return 1
  line="${line#"${line%%[![:space:]]*}"}"
  printf '%s\n' "${line%%[[:space:]]*}"
}

# The value of one "key": "value" pair in the state file, or nothing.
state_value() {
  [ -f "${STATE_FILE}" ] || return 0
  sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" "${STATE_FILE}" | head -1
}

# Rewrite the state file: write_state <agent> <dir> [<command>]; an empty dir
# or command is left out. Values are written unescaped, so callers reject
# double quotes, backslashes and newlines first (see CUSTOM AGENTS).
write_state() {
  mkdir -p "$(dirname "${STATE_FILE}")"
  {
    printf '{\n  "agent": "%s"' "$1"
    [ -z "${3:-}" ] || printf ',\n  "command": "%s"' "$3"
    [ -z "$2" ] || printf ',\n  "dir": "%s"' "$2"
    printf '\n}\n'
  } > "${STATE_FILE}.new"
  mv -f "${STATE_FILE}.new" "${STATE_FILE}"
}

current_agent() {
  local a
  a="$(state_value agent)"
  printf '%s\n' "${a:-${DEFAULT_AGENT}}"
}

start_dir() {
  local d="${GALLERY_AGENT_DIR:-$(state_value dir)}"
  d="${d:-${HOME}}"
  if [ -d "${d}" ]; then
    printf '%s\n' "${d}"
  else
    echo "gallery agent: ${d} is not reachable, starting in ${HOME}" >&2
    printf '%s\n' "${HOME}"
  fi
}

# A new terminal window running this script's `launch` verb.
#
# The window's command is a LOGIN shell (`zsh -l`), not the agent binary
# directly: the terminal inherits launchd's PATH, which has neither Homebrew nor the
# node prefixes on it, so `claude` would not be found. `-l` is enough -- it
# sources .zprofile, where brew shellenv sets PATH -- and it is deliberately
# not `-i`: an interactive shell would also source .zshrc for nothing.
#
# The script path is passed as $0 rather than interpolated into the quoted
# command, so a path containing spaces or quotes cannot break out of it.
open_window() {
  local script="$1" name="${2:-}"
  local command="/bin/zsh -l -c 'exec \"\$0\" launch' \"${script}\""
  # A named agent (`open <name>`) is handed to `launch` as $1; valid_name has
  # already limited it to characters that need no quoting.
  [ -z "${name}" ] || command="/bin/zsh -l -c 'exec \"\$0\" launch \"\$1\"' \"${script}\" \"${name}\""
  # Test seam: tests/agent_test.sh asserts on the command without ever
  # opening a window (see the login-shell note above -- it is the one part
  # of this that is easy to get subtly wrong).
  if [ -n "${GALLERY_AGENT_PRINT_COMMAND:-}" ]; then
    printf '%s\n' "${command}"
    return 0
  fi
  # A tiled window of the configured terminal, opened by gallery-term (cold
  # start included: it launches and waits for iTerm2 and Ghostty first, which
  # are not ready for AppleScript immediately). On iTerm2 it prints the new
  # window's id; the other terminals print nothing and go without the
  # Space check below.
  local term wid
  term="${GALLERY_TERM_BIN:-$(dirname "${SELF}")/gallery-term}"
  [ -x "${term}" ] || term="${HOME}/bin/gallery-term"
  if [ -n "${name}" ]; then
    wid="$("${term}" open --role tile -- /bin/zsh -l -c 'exec "$0" launch "$1"' "${script}" "${name}")" || return 0
  else
    wid="$("${term}" open --role tile -- /bin/zsh -l -c 'exec "$0" launch' "${script}")" || return 0
  fi
  case "${wid}" in ''|*[!0-9]*) return 0 ;; esac
  keep_on_current_space "${wid}"
}

# keep_on_current_space <window id> -- moves the new window to the Space the
# user is looking at, if macOS put it somewhere else.
#
# Pressing the key straight after switching Spaces (super+2, or ctrl+2 itself)
# lands inside the ~0.5 s switch animation, and a window created then can be
# placed on the Space being LEFT: the key looks dead on the new Space while
# the agent quietly opens on the old one (2026-10-01, seen once, not
# reproducible on demand -- which is what a race looks like). The reference
# is therefore the Space in view once the window exists and the switch has
# settled, not the one captured at key press: mid-animation, yabai can still
# report the old Space as focused.
#
# iTerm's AppleScript window id is the CGWindowID yabai uses, so the two can
# be compared directly. Skipped silently whenever yabai is absent or never
# sees the window (the AX-less windows plugins/gallery.ghosts exists for);
# this only ever corrects a misplaced window, it never blocks one opening.
keep_on_current_space() {
  local wid="$1" win_space="" view_space="" waited=0
  [ -n "${wid}" ] && command -v yabai >/dev/null 2>&1 || return 0
  # yabai learns of the window a moment after iTerm creates it.
  while [ -z "${win_space}" ] && [ "${waited}" -lt 20 ]; do
    win_space="$(yabai -m query --windows --window "${wid}" 2>/dev/null \
      | sed -n 's/^[[:space:]]*"space":[[:space:]]*\([0-9][0-9]*\).*/\1/p' | head -1)"
    [ -n "${win_space}" ] && break
    sleep 0.1
    waited=$((waited + 1))
  done
  [ -n "${win_space}" ] || return 0
  view_space="$(yabai -m query --spaces --space 2>/dev/null \
    | sed -n 's/^[[:space:]]*"index":[[:space:]]*\([0-9][0-9]*\).*/\1/p' | head -1)"
  [ -n "${view_space}" ] && [ "${win_space}" != "${view_space}" ] || return 0
  yabai -m window "${wid}" --space "${view_space}" >/dev/null 2>&1 || return 0
  yabai -m window "${wid}" --focus >/dev/null 2>&1 || true
}

case "${1:-open}" in
  list)
    # One row per agent: the built-ins, then every custom agent (registered,
    # or the default's own line). A custom line is shown with the row.
    row() {
      local a="$1" c extra="" mark="-"
      c="$(custom_line "$a")"
      command -v "$(agent_program "$a")" >/dev/null 2>&1 && mark="installed"
      [ "$a" = "$(current_agent)" ] && extra="default"
      [ -z "${c}" ] || extra="${extra:+${extra}, }custom: ${c}"
      printf '%-10s %s%s\n' "$a" "${mark}" "${extra:+ (${extra})}"
    }
    for a in ${SUPPORTED}; do row "$a"; done
    customs=""
    if [ -d "${AGENTS_DIR}" ]; then
      for f in "${AGENTS_DIR}"/*; do
        [ -f "$f" ] || continue
        a="$(basename "$f")"
        case "$a" in *.new) continue ;; esac
        valid_name "$a" || continue
        customs="${customs} ${a}"
      done
    fi
    a="$(current_agent)"
    [ -z "$(custom_command)" ] || customs="${customs} ${a}"
    printf '%s\n' ${customs} | sort -u | while read -r a; do
      [ -n "$a" ] || continue
      agent_command "$a" >/dev/null 2>&1 && continue   # already listed above
      row "$a"
    done
    ;;
  status)
    a="$(current_agent)"
    printf 'agent:   %s%s\n' "$a" "$(command -v "$(agent_program "$a")" >/dev/null 2>&1 || echo ' (NOT INSTALLED)')"
    printf 'starts:  %s\n' "$(start_dir 2>/dev/null)"
    printf 'command: %s%s\n' "$(agent_line "$a" 2>/dev/null)" "$([ -z "$(custom_line "$a")" ] || echo ' (custom)')"
    printf 'state:   %s\n' "${STATE_FILE}"
    ;;
  set)
    name="${2:?usage: gallery agent set <name> [--command \"<command line>\"]}"
    valid_name "${name}" || die "agent names use letters, digits, . _ - only: ${name}"
    line=""
    if [ "${3:-}" = "--command" ]; then
      line="${4:-}"
      [ $# -eq 4 ] && check_line "${line}" \
        || die "usage: gallery agent set <name> --command \"<command line>\""
      register "${name}" "${line}"
    elif [ $# -gt 2 ]; then
      die "usage: gallery agent set <name> [--command \"<command line>\"]"
    elif agent_command "${name}" >/dev/null 2>&1; then
      # A built-in without --command goes back to its own command line.
      rm -f "${AGENTS_DIR}/${name}"
    elif [ -f "${AGENTS_DIR}/${name}" ]; then
      line="$(head -n 1 "${AGENTS_DIR}/${name}")"
    else
      die "unsupported agent: ${name} (one of: ${SUPPORTED}; or give it a command: set ${name} --command \"<command line>\")"
    fi
    warn_if_missing "${line:-${name}}"
    write_state "${name}" "$(state_value dir)" "${line}"
    echo "default agent: ${name}${line:+ (custom: ${line})}"
    ;;
  add)
    name="${2:-}"
    valid_name "${name}" && [ "${3:-}" = "--command" ] && [ $# -eq 4 ] \
      || die "usage: gallery agent add <name> --command \"<command line>\""
    line="$4"
    check_line "${line}" || die "usage: gallery agent add <name> --command \"<command line>\""
    register "${name}" "${line}"
    # Re-registering the default changes what the key starts, so the state
    # file's copy of its line follows.
    if [ "${name}" = "$(current_agent)" ]; then
      write_state "${name}" "$(state_value dir)" "${line}"
    fi
    warn_if_missing "${line}"
    echo "registered agent: ${name} (custom: ${line}); start it with: gallery agent open ${name}"
    ;;
  remove)
    name="${2:-}"
    valid_name "${name}" && [ $# -eq 2 ] || die "usage: gallery agent remove <name>"
    [ -f "${AGENTS_DIR}/${name}" ] || die "${name} is not a registered agent (gallery agent list)"
    [ "${name}" != "$(current_agent)" ] \
      || die "${name} is the default agent; choose another first (gallery agent set <name>)"
    rm -f "${AGENTS_DIR}/${name}"
    echo "removed agent: ${name}"
    ;;
  dir)
    case "${2:-}" in
      "") start_dir ;;
      --clear)
        write_state "$(current_agent)" "" "$(custom_command)"
        echo "start directory: \$HOME (GALLERY_AGENT_DIR still overrides)"
        ;;
      *)
        [ -d "$2" ] || die "not a directory: $2"
        d="$(cd "$2" && pwd)"
        write_state "$(current_agent)" "${d}" "$(custom_command)"
        echo "start directory: ${d}"
        ;;
    esac
    ;;
  open)
    # Checked here as well as in `launch`, so a missing agent is reported in
    # the terminal the key was pressed from instead of in a window that
    # opens and closes again before it can be read. From the key there is no
    # terminal, so it is also shown as a notification.
    # `open <name>` starts that agent once and leaves the default alone.
    [ $# -le 2 ] || die "usage: gallery agent open [<name>]"
    a="${2:-$(current_agent)}"
    valid_name "$a" || die "agent names use letters, digits, . _ - only: $a"
    known_agent "$a" || die "unknown agent: $a (gallery agent list; register one with: gallery agent add $a --command \"<command line>\")"
    if ! command -v "$(agent_program "$a")" >/dev/null 2>&1; then
      [ -n "${GALLERY_NO_NOTIFY:-}" ] || /usr/bin/osascript -e "display notification \"${a} is not installed. Install it, or choose another agent: gallery agent list\" with title \"Gallery: no coding agent\"" >/dev/null 2>&1 || true
      die "${a} is not installed (gallery agent list)"
    fi
    open_window "${SELF}" "${2:-}"
    ;;
  inline|launch)
    [ $# -le 2 ] || die "usage: gallery agent inline [<name>]"
    a="${2:-$(current_agent)}"
    valid_name "$a" || die "agent names use letters, digits, . _ - only: $a"
    known_agent "$a" || die "unknown agent: $a (gallery agent list)"
    command -v "$(agent_program "$a")" >/dev/null 2>&1 || die "${a} is not installed (gallery agent list)"
    if [ -n "$(custom_line "$a")" ]; then
      # A custom command line: run by a shell so its own quoting applies.
      line="$(agent_line "$a")"
      cd "$(start_dir)"
      eval "exec ${line}"
    fi
    # Read the command into an array before the cd, so a failure here is
    # reported from a known directory.
    cmd=()
    while IFS= read -r part; do cmd+=("$part"); done < <(agent_command "$a")
    cd "$(start_dir)"
    exec "${cmd[@]}"
    ;;
  *)
    die "usage: gallery agent [open [<name>]|inline [<name>]|status|list|set <name> [--command \"<line>\"]|add <name> --command \"<line>\"|remove <name>|dir]"
    ;;
esac
