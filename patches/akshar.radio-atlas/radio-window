#!/usr/bin/env bash
# Gallery macOS patch for akshar.radio-atlas 0.1.9: upstream radio-window
# uses `hyprctl eval` to install a Hyprland Lua window rule (float, center,
# fixed size) for the plugin's panel window. Hyprland does not exist on
# macOS, and Gallery's QML host (qml/host.py) already centers and sizes
# the panel window itself before showing it. RadioAtlas.qml runs this
# script fire-and-forget (windowSetupProcess, no output/exit-code check),
# so a silent, always-successful no-op is a faithful macOS replacement.
exit 0
