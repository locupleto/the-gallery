#!/usr/bin/env bash
# Derived from omarchy-radio-atlas, Copyright (c) 2026 Akshar Patel, MIT
# licence (see THIRD_PARTY_NOTICES.md at the repository root).
# Gallery macOS patch for akshar.radio-atlas 0.1.9: upstream starts the
# proxy under `setpriv --pdeathsig TERM` (util-linux, absent on macOS),
# then runs mpv inside a `bwrap` network namespace (`--unshare-net`) that
# has only loopback up, forcing every connection mpv makes through the
# socat/radio-sandbox bridge into the SSRF-filtering radio-proxy -- that
# is the plugin's actual network sandbox. bubblewrap does not exist on
# macOS and there is no equivalent kernel primitive to build one from a
# plain shell script (no user namespaces / unshare(2) exposed to bash), so
# this drops both `setpriv` and the `bwrap` network-namespace wrapper and
# runs radio-sandbox directly.
#
# Trade-off (documented in PATCH-NOTES.md): on macOS mpv keeps normal
# network access. It is still launched with http_proxy/https_proxy set to
# the radio-sandbox bridge (so well-behaved requests still pass through
# radio-proxy's public-address/redirect filtering), but nothing stops mpv
# (or a library it loads) from ignoring those env vars and connecting
# directly -- the isolation is advisory, not enforced, unlike upstream's
# network-namespace version. This only matters for a maliciously crafted
# stream URL trying to reach a private/local address (SSRF); ordinary
# playback of a real internet radio stream is unaffected either way.
set -euo pipefail
umask 077

: "${XDG_RUNTIME_DIR:?Radio Atlas requires XDG_RUNTIME_DIR}"
script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
runtime_dir="$XDG_RUNTIME_DIR/omarchy-radio-atlas"
proxy_socket="$runtime_dir/proxy.sock"
proxy_pid=""
sandbox_pid=""

cleanup() {
  local exit_code=$?
  trap - EXIT INT TERM
  [[ -z $sandbox_pid ]] || kill "$sandbox_pid" 2>/dev/null || true
  [[ -z $sandbox_pid ]] || wait "$sandbox_pid" 2>/dev/null || true
  [[ -z $proxy_pid ]] || kill "$proxy_pid" 2>/dev/null || true
  [[ -z $proxy_pid ]] || wait "$proxy_pid" 2>/dev/null || true
  rm -f "$proxy_socket"
  exit "$exit_code"
}
trap cleanup EXIT INT TERM

rm -f "$proxy_socket"
python3 "$script_dir/radio-proxy" "$proxy_socket" \
  > "$runtime_dir/proxy.log" 2>&1 &
proxy_pid=$!
for _ in $(seq 1 100); do
  [[ -S $proxy_socket ]] && break
  kill -0 "$proxy_pid" 2>/dev/null || break
  sleep 0.02
done
[[ -S $proxy_socket ]] || exit 4

"$script_dir/radio-sandbox" "$proxy_socket" "$@" &
sandbox_pid=$!
wait "$sandbox_pid"
