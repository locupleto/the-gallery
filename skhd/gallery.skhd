# The Gallery key bindings, included by ~/.config/skhd/skhdrc via `.load "gallery.skhd"`.
# skhd is the only hotkey grabber on this machine; Hammerspoon binds no keys of
# its own. Each line calls the Gallery CLI, which opens terminal-style plugins
# (tui/menu kinds) in a floating terminal window itself and routes webview kinds
# over the hs IPC bridge.
# Installed by the-gallery/install.sh; edit the copy in the repo, not this file.
#
# Lines starting with "## " are picked up by the tiler key sheet generator.
# Learn stays on super+space in the tiler's own skhdrc.

## Gallery: system monitor (btop in a floating terminal)
lalt + shift - 0 : "$HOME/bin/gallery" toggle gallery.sysmon
## Gallery: spaces and windows picker (fzf in a floating terminal)
lalt + ctrl - 0 : "$HOME/bin/gallery" toggle gallery.spaces
## Gallery: Radio Atlas (world radio globe)
lalt + cmd - 0 : "$HOME/bin/gallery" toggle akshar.radio-atlas
## Gallery: theme picker -- palette + wallpaper preview, Enter drops into that theme's backgrounds; ctrl-t inside toggles whether the terminal console follows the theme, ctrl-w cycles the JankyBorders focus-outline width, ctrl-b toggles its "bright" mix
shift + ctrl + lalt - space : "$HOME/bin/gallery" toggle gallery.themes
## Gallery: background picker (direct; image preview, current theme's wallpapers)
shift + ctrl + lalt - b : "$HOME/bin/gallery" toggle gallery.backgrounds
## Gallery: weather glance panel
# Omarchy's own SUPER + CTRL + ALT + W ("Toggle weather"), minus the ALT --
# in the Gallery lalt already IS Omarchy's SUPER, so that literal
# combination cannot be expressed on macOS.
ctrl + lalt - w : "$HOME/bin/gallery" toggle gallery.weather

## launch the default coding agent in a new terminal window
# Omarchy's own SUPER+SHIFT+CTRL+A, same keys, and the same shape: an ordinary
# terminal window, tiled with everything else, not a floating Gallery surface
# -- an agent is worked in for an hour, not glanced at. Every press opens
# another one, as Omarchy's does; close it by quitting the agent.
shift + ctrl + lalt - a : "$HOME/bin/gallery" agent
## Gallery: next background for the current theme (Omarchy-style cycle)
ctrl + lalt - space : "$HOME/bin/gallery" bg next
