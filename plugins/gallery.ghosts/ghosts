#!/bin/sh
# ghosts -- find windows the tiler cannot see, and get rid of them.
#
#   ghosts check            service run: skip while the screen is locked, else
#                           scan, relaunch allow-listed apps, report the rest once
#   ghosts list             human-readable scan
#   ghosts scan             machine-readable scan (TSV: id layer pid owner name x y w h)
#   ghosts fix [OWNER|ID]   quit + relaunch the app(s) owning ghost windows;
#                           re-insert orphans into the tree
#   ghosts forget           clear the reported/handled state
#
# A window created while the screen is locked (typically an app's own updater
# quitting and relaunching it, e.g. Claude's ShipIt at 08:27 on 2026-09-18) gets
# no accessibility reference. yabai never sees it, cannot tile it, and macOS
# leaves it at window layer -1 -- underneath every tile, visible only as ghost
# text through the iTerm glass. Nothing can give that window AX afterwards; the
# only cure is a fresh window, i.e. relaunching the app.
#
# Detection compares the window server's on-screen list (CGWindowListCopyWindowInfo,
# reached through JXA's ObjC bridge so no Python, pyobjc or extra grants are
# needed) with yabai's window list: a normal-layer window of real size that yabai
# does not know is a ghost. The cure is a fresh window, so the owning app is
# quit gracefully (its own unsaved-changes sheet still protects the user; an
# app that declines is left alone) and reopened -- silently, log only. Apps in
# NO_RELAUNCH are never restarted unasked because the restart itself is the
# damage (terminals, VM hosts, calls); those, and an app that refused to quit,
# get a single silent notification, the only two cases a human is needed
# (policy 2026-09-20: the Gallery fixes, it does not nag). A ghost must persist
# for GRACE seconds first, so a window caught mid-creation (briefly AX-less)
# is never acted on.
#
# A third class needs no relaunch: an "orphan" is a window yabai sees perfectly
# well (AX, standard subrole, not floating) that has no node in its Space's BSP
# tree, so it sits unmanaged on top of whichever tile it last had (an iTerm
# window over Claude's tile, 2026-09-18 18:40; cause unknown, yabai logged
# nothing). yabai reports split "none" for such a window while every real tile
# on a Space with two or more of them reports a split. The cure is to toggle
# float twice, which re-inserts it next to the focused window. Overrides:
# ~/.config/gallery/ghosts.conf (sh syntax, sets NO_RELAUNCH / IGNORE /
# ANNOUNCE / GRACE).

set -eu
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"   # ioreg is in /usr/sbin

CONFIG_DIR="$HOME/.config/gallery"
STATE_FILE="$CONFIG_DIR/state/ghosts.json"
LOG_FILE="$HOME/Library/Logs/gallery-ghosts.log"

# Apps never relaunched unasked: a restart loses a shell session, a running VM
# or a call, which is worse than the ghost. Everything else is restarted.
NO_RELAUNCH="iTerm2 Terminal kitty Alacritty WezTerm Ghostty UTM Parallels Desktop VMware Fusion VirtualBox zoom.us FaceTime Microsoft Teams"
# Window owners that legitimately live outside yabai's tree.
IGNORE="Window Server borders Dock Hammerspoon Übersicht Notification Center Control Center Spotlight loginwindow Wallpaper WallpaperAgent screencapture Screenshot ScreenSaverEngine Siri Shortcuts CoreServicesUIAgent"
# How to reach the user in the two cases that need one (NO_RELAUNCH app, app that
# refused to quit): 0 = never, 1 = notification banner, 2 = banner + a spoken line via ~/bin/tts-say,
# if installed.
# Successful fixes are never announced, only logged.
ANNOUNCE=1
# Seconds a ghost must persist across checks before anything is said or done. A
# window is AX-less for an instant while it is being created; a file picker
# (Telegram's Open panel, 2026-09-18 16:27) caught in that instant looked like
# a ghost and was announced, then tiled normally. Real ghosts persist for hours.
GRACE=60
[ -f "$CONFIG_DIR/ghosts.conf" ] && . "$CONFIG_DIR/ghosts.conf"

log() { printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG_FILE"; }

# ioreg, not CGSessionCopyCurrentDictionary: the latter comes back empty from a
# script while the screen is locked, which read as "unlocked" (seen 2026-09-18).
screen_locked() {
  ioreg -n Root -d1 -a 2>/dev/null | plutil -p - 2>/dev/null | grep -q '"CGSSessionScreenIsLocked" => true'
}

US=$(printf '\037')   # field separator: not IFS whitespace, so empty titles keep their column

# All on-screen windows from the window server, US-separated, before any filtering.
window_server_list() {
  osascript -l JavaScript -e '
    ObjC.import("CoreGraphics");
    var opts = $.kCGWindowListOptionOnScreenOnly | $.kCGWindowListExcludeDesktopElements;
    var arr = ObjC.castRefToObject($.CGWindowListCopyWindowInfo(opts, $.kCGNullWindowID));
    var out = [];
    for (var i = 0; i < arr.count; i++) {
      var w = ObjC.deepUnwrap(arr.objectAtIndex(i)); var b = w.kCGWindowBounds;
      out.push([w.kCGWindowNumber, w.kCGWindowLayer, w.kCGWindowOwnerPID,
                String(w.kCGWindowOwnerName || "").replace(/[\u001f\n]/g, " "),
                String(w.kCGWindowName || "").replace(/[\u001f\n]/g, " ").slice(0, 60),
                Math.round(b.X), Math.round(b.Y), Math.round(b.Width), Math.round(b.Height)].join("\u001f"));
    }
    out.join("\n")' 2>/dev/null
}

# Ghosts: normal-ish layer (-20..0), at least 200x100, owner not ignored, and
# not a window yabai holds an accessibility reference for. yabai does list some
# AX-less windows (has-ax-reference false, blank title) -- those count as ghosts.
scan() {
  # GHOSTS_YABAI overrides the yabai binary (tests: point it at `false` and every
  # tiled window must show up as a ghost).
  yabai_ids=$(${GHOSTS_YABAI:-yabai} -m query --windows 2>/dev/null | jq -r '.[] | select(.["has-ax-reference"]) | .id' | tr '\n' ' ')
  window_server_list | while IFS="$US" read -r id layer pid owner name x y w h; do
    [ "$layer" -ge -20 ] && [ "$layer" -le 0 ] || continue
    [ "$w" -ge 200 ] && [ "$h" -ge 100 ] || continue
    case " $IGNORE " in *" $owner "*) continue ;; esac
    case " $yabai_ids " in *" $id "*) continue ;; esac
    printf '%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\n' "$id" "$layer" "$pid" "$owner" "$name" "$x" "$y" "$w" "$h"
  done
  # Second source: AX-less windows yabai DID record and still tiles. A hidden
  # app's window born behind the lock (Calendar, 2026-09-18) is not on screen
  # at all, yet its node keeps an empty slot in the BSP tree. Layer "tile".
  #
  # The last clause is the harm test, added 2026-09-22. Losing the AX reference
  # is not by itself a reason to quit someone's application: an AX-less window
  # that is neither visible nor holding a slot in the tree costs nothing, and
  # Claude and ChatGPT both leave exactly such a stub behind (is-visible false,
  # split-type "none", can-move/can-resize false, role and subrole empty).
  # Relaunching over it is what produced the 2026-09-22 loop. Act only when the
  # ghost actually costs something:
  #   is-visible          -- it is on screen as ghost text under the tiles, or
  #   split-type != none  -- it holds a BSP slot, i.e. an empty gap (Calendar).
  # Both halves are needed: requiring is-visible alone would delete the very
  # case this second source exists for, since that window is not on screen.
  ${GHOSTS_YABAI:-yabai} -m query --windows 2>/dev/null | jq -r --arg us "$US" '
    .[] | select((.["has-ax-reference"] | not) and (.["is-floating"] | not) and (.["is-minimized"] | not)
                 and (.["is-visible"] or (.["split-type"] != "none")))
    | [.id, "tile", .pid, .app, (.title // ""), (.frame.x|floor), (.frame.y|floor), (.frame.w|floor), (.frame.h|floor)]
    | map(tostring) | join($us)' | while IFS="$US" read -r id layer pid owner name x y w h; do
    case " $IGNORE " in *" $owner "*) continue ;; esac
    printf '%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\n' "$id" "$layer" "$pid" "$owner" "$name" "$x" "$y" "$w" "$h"
  done
  # Third source: orphans -- tileable windows on a visible bsp Space that have
  # no node in its tree (split "none" while the Space holds two or more
  # tileable windows). Layer "orphan"; the fix is retile_window, not a relaunch.
  # While the screen is locked yabai can answer --spaces with a bare "[" (seen on
  # macOS 12): no Spaces then, rather than a jq error every run.
  bsp_spaces=$(${GHOSTS_YABAI:-yabai} -m query --spaces 2>/dev/null | jq -c '[.[] | select(.type == "bsp" and .["is-visible"]) | .index]' 2>/dev/null || true)
  ${GHOSTS_YABAI:-yabai} -m query --windows 2>/dev/null | jq -r --arg us "$US" --argjson spaces "${bsp_spaces:-[]}" '
    map(select(.["has-ax-reference"] and .subrole == "AXStandardWindow" and .["is-visible"]
               and (.["is-floating"] | not) and (.["is-minimized"] | not) and (.["is-hidden"] | not)
               and ([.space] | inside($spaces))))
    | group_by(.space)[] | select(length >= 2) | .[] | select(.["split-type"] == "none")
    | [.id, "orphan", .pid, .app, (.title // ""), (.frame.x|floor), (.frame.y|floor), (.frame.w|floor), (.frame.h|floor)]
    | map(tostring) | join($us)' | while IFS="$US" read -r id layer pid owner name x y w h; do
    case " $IGNORE " in *" $owner "*) continue ;; esac
    printf '%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\n' "$id" "$layer" "$pid" "$owner" "$name" "$x" "$y" "$w" "$h"
  done
}

# Put an orphan back into its Space's tree: floating it and un-floating it makes
# yabai insert a fresh node (next to the focused window). Verified by the split
# field turning non-"none".
retile_window() {
  id=$1; owner=$2
  yabai -m window "$id" --toggle float >/dev/null 2>&1 && yabai -m window "$id" --toggle float >/dev/null 2>&1 || {
    log "retile $owner: yabai refused window $id"; return 1; }
  split=$(yabai -m query --windows --window "$id" 2>/dev/null | jq -r '.["split-type"] // "none"')
  if [ "$split" = "none" ]; then log "retile $owner: window $id still has no node"; return 1; fi
  log "retiled $owner window $id"
}

announce() {
  log "announce: $1"
  [ "$ANNOUNCE" != 0 ] || return 0
  osascript -e "display notification \"$1\" with title \"The Gallery\" subtitle \"Ghost window\"" >/dev/null 2>&1 || true
  if [ "$ANNOUNCE" = 2 ] && [ -x "$HOME/bin/tts-say" ]; then
    # Detached: the service runner waits for this process, not for the speech.
    nohup "$HOME/bin/tts-say" --source gallery.ghosts "$1" >/dev/null 2>&1 </dev/null &
  fi
}

# Graceful quit via NSRunningApplication (same as the Quit menu item), wait for
# the process to go, then open the bundle again. An app that refuses to quit
# (unsaved-changes dialog) is left alone and reported.
relaunch_pid() {
  pid=$1; owner=$2
  # Resolve the bundle BEFORE quitting anything. A degraded app (Notes, five
  # days old and already AX-less, 2026-09-20) answered terminate() but then
  # gave no bundleURL: the one-shot version quit it and, seeing no path,
  # believed nothing had happened. Fall back to the executable's path.
  path=$(osascript -l JavaScript -e '
    ObjC.import("AppKit");
    var app = $.NSRunningApplication.runningApplicationWithProcessIdentifier('"$pid"');
    if (app.isNil() || app.bundleURL.isNil()) { "" } else { app.bundleURL.path.js }' 2>/dev/null)
  if [ -z "$path" ]; then
    exe=$(ps -o comm= -p "$pid" 2>/dev/null || true)
    case "$exe" in *.app/Contents/MacOS/*) path=${exe%%.app/Contents/MacOS/*}.app ;; esac
  fi
  if [ -z "$path" ]; then
    # Not a running application. If the process is gone too, yabai was holding
    # stale records for an app that quit behind the lock (Screen Sharing,
    # 2026-09-18): nothing to relaunch, the empty tiles clear on their own.
    if kill -0 "$pid" 2>/dev/null; then
      log "relaunch $owner: pid $pid is alive but not an application, leaving it"; return 1
    fi
    log "relaunch $owner: pid $pid already gone; yabai held stale windows"; return 0
  fi
  # Graceful quit (same as the Quit menu item); SIGTERM if AppKit cannot see it.
  quit=$(osascript -l JavaScript -e '
    ObjC.import("AppKit");
    var app = $.NSRunningApplication.runningApplicationWithProcessIdentifier('"$pid"');
    if (app.isNil()) { "no" } else { app.terminate(); "yes" }' 2>/dev/null)
  [ "$quit" = yes ] || kill -TERM "$pid" 2>/dev/null || true
  i=0
  while kill -0 "$pid" 2>/dev/null && [ $i -lt 40 ]; do sleep 0.5; i=$((i+1)); done
  if kill -0 "$pid" 2>/dev/null; then
    log "relaunch $owner: did not quit within 20s, leaving it"
    announce "$owner has a window the tiler cannot see and did not quit when asked; save your work there and relaunch it when convenient."
    return 1
  fi
  open -a "$path" && log "relaunched $owner from $path"
}

state_get() { [ -f "$STATE_FILE" ] && jq -r --arg id "$1" '.[$id].action // empty' "$STATE_FILE" 2>/dev/null || true; }
state_at()  { [ -f "$STATE_FILE" ] && jq -r --arg id "$1" '.[$id].at // empty' "$STATE_FILE" 2>/dev/null || true; }
state_set() {
  mkdir -p "$(dirname "$STATE_FILE")"
  [ -f "$STATE_FILE" ] || echo '{}' > "$STATE_FILE"
  tmp=$(mktemp); jq --arg id "$1" --arg owner "$2" --arg action "$3" --argjson at "$(date +%s)" \
    '.[$id] = {owner: $owner, action: $action, at: $at}' "$STATE_FILE" > "$tmp" && mv "$tmp" "$STATE_FILE"
}
# window_diag <id> -- the yabai fields that decide whether a ghost is costing
# anything, rendered for the log. The 2026-09-22 investigation was slowed badly
# by their absence: the log recorded only id/layer/pid/owner/title/frame, so
# there was no way to tell after the fact whether a past ghost had been visible
# or holding a tile slot, and the specimens were gone by the time anyone
# looked. Prints nothing when yabai has no record of the id (a first-source
# ghost, which by definition it does not).
window_diag() {
  ${GHOSTS_YABAI:-yabai} -m query --windows 2>/dev/null | jq -r --argjson want "$1" '
    .[] | select(.id == $want)
    | "visible=\(.["is-visible"]) split=\(.["split-type"]) can-move=\(.["can-move"]) role=\"\(.role)\" subrole=\"\(.subrole)\""' 2>/dev/null | head -1
}

# --- relaunch circuit breaker ---------------------------------------------
# State above is keyed by WINDOW id, and a relaunch hands the app a brand new
# window with a brand new id -- so a re-ghosting app looked like a first
# offence on every pass. On 2026-09-22 that quit and relaunched Claude and
# ChatGPT roughly every 90 s for hours: the window ghosts sees is the one its
# own `open -a` just produced. The rule that ends it: if an app ghosts again
# after being relaunched, relaunching is not the cure. Say so once, then leave
# it alone. Keyed by OWNER, not window id, because the id is exactly what
# changes. `ghosts forget` (or the cooldown) gives an owner another chance.
OWNER_PREFIX="owner:"
RELAUNCH_COOLDOWN=21600   # 6 h before an owner is trusted with another attempt

owner_state() { state_get "${OWNER_PREFIX}$1"; }
owner_at()    { state_at  "${OWNER_PREFIX}$1"; }
owner_mark()  { state_set "${OWNER_PREFIX}$1" "$1" "$2"; }

# breaker_allows <owner> -- 0 when this owner may be relaunched now.
breaker_allows() {
  _o=$1
  _st=$(owner_state "$_o")
  [ -n "$_st" ] || return 0                 # never relaunched: go ahead
  _at=$(owner_at "$_o"); [ -n "$_at" ] || _at=0
  if [ $(( $(date +%s) - _at )) -ge "$RELAUNCH_COOLDOWN" ]; then
    return 0                                # cooldown served, one more chance
  fi
  return 1
}

state_prune() {  # keep only ids still known to the window server OR yabai
  [ -f "$STATE_FILE" ] || return 0
  # Tile-class ghosts are not on screen, so the window-server list alone forgot
  # them every run and they were announced again each time (2026-09-18).
  live=$( { window_server_list | cut -d "$US" -f1; ${GHOSTS_YABAI:-yabai} -m query --windows 2>/dev/null | jq -r '.[].id'; } | jq -R . | jq -s .)
  # Owner records (the relaunch breaker) are deliberately NOT pruned: they are
  # not window ids, and forgetting them is what re-arms the loop.
  tmp=$(mktemp); jq --argjson live "$live" 'with_entries(select((.key | startswith("owner:")) or (.key as $k | $live | index($k))))' "$STATE_FILE" > "$tmp" && mv "$tmp" "$STATE_FILE"
}

cmd_check() {
  if screen_locked; then exit 0; fi   # never act behind the lock: that is what creates ghosts
  found=$(scan)
  state_prune
  [ -n "$found" ] || exit 0
  now=$(date +%s)
  printf '%s\n' "$found" | while IFS="$US" read -r id layer pid owner name x y w h; do
    action=$(state_get "$id")
    case "$action" in
      "")   state_set "$id" "$owner" seen
            log "candidate: id=$id layer=$layer pid=$pid owner=$owner name='$name' ${w}x${h} at $x,$y $(window_diag "$id") (waiting ${GRACE}s)"
            continue ;;
      seen) [ $((now - $(state_at "$id"))) -ge "$GRACE" ] || continue ;;
      *)    continue ;;   # already reported / relaunched
    esac
    log "ghost: id=$id layer=$layer pid=$pid owner=$owner name='$name' ${w}x${h} at $x,$y $(window_diag "$id")"
    if [ "$layer" = orphan ]; then
      state_set "$id" "$owner" retiling
      if retile_window "$id" "$owner"; then
        state_set "$id" "$owner" retiled
      else
        state_set "$id" "$owner" reported
        announce "A $owner window has dropped out of the tiling tree and would not go back."
      fi
      continue
    fi
    case " $NO_RELAUNCH " in
      *" $owner "*)
        state_set "$id" "$owner" reported
        announce "$owner has a window the tiler cannot see; it is not restarted unasked, relaunch it when convenient." ;;
      *)
        if ! breaker_allows "$owner"; then
          state_set "$id" "$owner" reported
          if [ "$(owner_state "$owner")" = exhausted ]; then
            log "breaker: $owner still ghosting after a relaunch; staying quiet"
          else
            owner_mark "$owner" exhausted
            log "breaker: $owner ghosted again after a relaunch; not retrying for ${RELAUNCH_COOLDOWN}s"
            announce "$owner has a window the tiler cannot see. Relaunching it did not help, so it is being left alone; quit and reopen it yourself when convenient."
          fi
          continue
        fi
        state_set "$id" "$owner" relaunching
        if relaunch_pid "$pid" "$owner"; then
          owner_mark "$owner" relaunched
          state_set "$id" "$owner" relaunched
        else state_set "$id" "$owner" reported; fi ;;
    esac
  done
}

cmd_list() {
  found=$(scan)
  if [ -z "$found" ]; then echo "no ghost windows"; return 0; fi
  printf 'ID\tLAYER\tPID\tOWNER\tTITLE\tFRAME\n'
  printf '%s\n' "$found" | while IFS="$US" read -r id layer pid owner name x y w h; do
    printf '%s\t%s\t%s\t%s\t%s\t%sx%s at %s,%s\n' "$id" "$layer" "$pid" "$owner" "${name:--}" "$w" "$h" "$x" "$y"
  done
}

cmd_fix() {
  want=${1:-}
  found=$(scan)
  [ -n "$found" ] || { echo "no ghost windows"; return 0; }
  done_pids=" "
  printf '%s\n' "$found" | while IFS="$US" read -r id layer pid owner name x y w h; do
    if [ -n "$want" ] && [ "$want" != "$id" ] && [ "$want" != "$owner" ]; then continue; fi
    if [ "$layer" = orphan ]; then
      echo "retiling $owner window $id"
      retile_window "$id" "$owner" && state_set "$id" "$owner" retiled
      continue
    fi
    case "$done_pids" in *" $pid "*) continue ;; esac
    done_pids="$done_pids$pid "
    echo "relaunching $owner (pid $pid, window $id)"
    # An explicit fix is never refused by the breaker -- it was asked for --
    # but it is recorded, so an app that ghosts again afterwards trips it.
    relaunch_pid "$pid" "$owner" && { owner_mark "$owner" relaunched; state_set "$id" "$owner" relaunched; }
  done
}

case "${1:-list}" in
  check)  cmd_check ;;
  list)   cmd_list ;;
  scan)   scan | tr '\037' '\t' ;;
  fix)    cmd_fix "${2:-}" ;;
  forget) rm -f "$STATE_FILE"; echo "state cleared" ;;
  *) echo "usage: ghosts check|list|scan|fix [OWNER|ID]|forget" >&2; exit 2 ;;
esac
