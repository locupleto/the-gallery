{
  "schemaVersion": 1,
  "id": "gallery.learn",
  "name": "Learn",
  "version": "0.1.0",
  "kinds": [
    "menu",
    "panel"
  ],
  "entryPoints": {
    "panel": "index.html"
  },
  "gallery": {
    "menu": {
      "placeholder": "Learn: pick a cheat sheet...",
      "width": 40,
      "rows": 12,
      "source": {
        "type": "command",
        "command": "/usr/bin/python3",
        "args": [
          "~/.config/gallery/plugins/gallery.learn/learn-menu.py",
          "list"
        ]
      }
    },
    "panel": {
      "width": 860,
      "height": 640,
      "transparent": false
    },
    "primaryKind": "menu"
  }
}