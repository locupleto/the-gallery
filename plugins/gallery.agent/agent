#!/usr/bin/env bash
#
# agent -- launch the default coding agent, modelled on Omarchy 4's
# omarchy-agent (/usr/share/omarchy/bin/omarchy-agent).
#
#   agent           launch the default agent (this is what the tui kind runs)
#   agent status    which agent is default, where it starts, is it installed
#   agent list      the supported agents and whether each is on PATH
#   agent set <name>  record the default agent
#
# Driven three ways, all ending here: the `gallery agent` CLI verb, the
# gallery.agent plugin's tui kind (a floating iTerm2 window), and
# shift+ctrl+super+a in skhd/gallery.skhd.
#
# THE START DIRECTORY. Omarchy cds to $HOME/Work before launching, because an
# agent will not remember a trust decision for $HOME and would re-ask on every
# session. The estate has no ~/Work; its equivalent is the git root, where
# every repo already lives, so one trust approval covers all of them. That is
# the default below and it applies however the agent is launched (Urban's
# ruling 2026-09-22, chosen over Omarchy's "only when PWD is $HOME" rule);
# GALLERY_AGENT_DIR overrides it, and a directory that has gone missing -- the
# git root lives on an external volume -- falls back to $HOME with a warning
# rather than failing to launch.
#
# PERMISSIONS. Each agent is started with its own spelling of "do not stop to
# ask", exactly as omarchy-agent does: a keypress-launched agent that sits
# waiting for an approval it cannot show is useless. This is a deliberate
# posture, not an oversight -- the agent has full file and shell access,
# unattended, in the start directory above.
set -euo pipefail

CONFIG_DIR="${GALLERY_CONFIG_DIR:-${HOME}/.config/gallery}"
STATE_FILE="${CONFIG_DIR}/state/agent.json"
DEFAULT_DIR="${GALLERY_AGENT_DIR:-/Volumes/Work/development/projects/git}"
DEFAULT_AGENT="claude"

# The supported agents and the flag each one needs to run unattended. Kept in
# the same order as Omarchy's own case statement so the two can be compared.
agent_command() {
  case "$1" in
    claude)   printf '%s\n' claude --permission-mode bypassPermissions ;;
    gemini)   printf '%s\n' gemini --yolo ;;
    opencode) printf '%s\n' opencode --auto ;;
    codex)    printf '%s\n' codex --dangerously-bypass-approvals-and-sandbox ;;
    copilot)  printf '%s\n' copilot --allow-all ;;
    crush)    printf '%s\n' crush --yolo ;;
    *) return 1 ;;
  esac
}

SUPPORTED="claude gemini opencode codex copilot crush"

die() { echo "gallery agent: $*" >&2; exit 1; }

current_agent() {
  local a=""
  [ -f "${STATE_FILE}" ] && a="$(sed -n 's/.*"agent"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "${STATE_FILE}" | head -1)"
  printf '%s\n' "${a:-${DEFAULT_AGENT}}"
}

start_dir() {
  if [ -d "${DEFAULT_DIR}" ]; then
    printf '%s\n' "${DEFAULT_DIR}"
  else
    echo "gallery agent: ${DEFAULT_DIR} is not reachable, starting in ${HOME}" >&2
    printf '%s\n' "${HOME}"
  fi
}

case "${1:-launch}" in
  list)
    for a in ${SUPPORTED}; do
      if command -v "$a" >/dev/null 2>&1; then mark="installed"; else mark="-"; fi
      [ "$a" = "$(current_agent)" ] && mark="${mark} (default)"
      printf '%-10s %s\n' "$a" "${mark}"
    done
    ;;
  status)
    a="$(current_agent)"
    printf 'agent:   %s%s\n' "$a" "$(command -v "$a" >/dev/null 2>&1 || echo ' (NOT INSTALLED)')"
    printf 'starts:  %s\n' "$(start_dir 2>/dev/null)"
    printf 'command: %s\n' "$(agent_command "$a" 2>/dev/null | tr '\n' ' ')"
    printf 'state:   %s\n' "${STATE_FILE}"
    ;;
  set)
    name="${2:?usage: gallery agent set <name>}"
    agent_command "${name}" >/dev/null 2>&1 || die "unsupported agent: ${name} (one of: ${SUPPORTED})"
    command -v "${name}" >/dev/null 2>&1 || echo "gallery agent: warning -- ${name} is not on PATH" >&2
    mkdir -p "$(dirname "${STATE_FILE}")"
    printf '{\n  "agent": "%s"\n}\n' "${name}" > "${STATE_FILE}.new"
    mv -f "${STATE_FILE}.new" "${STATE_FILE}"
    echo "default agent: ${name}"
    ;;
  launch)
    a="$(current_agent)"
    command -v "$a" >/dev/null 2>&1 || die "${a} is not installed (gallery agent list)"
    # KEEP THE WINDOW FINDABLE. gallery-tui finds, focuses and closes its window
    # by the terminal title it set ("Gallery: Agent"), and an agent that renames
    # the terminal makes its own window invisible to the Gallery: the next
    # keypress would open a SECOND session instead of focusing the running one.
    # Claude Code has a switch for this; agents without one will show that
    # symptom until an equivalent is found.
    export CLAUDE_CODE_DISABLE_TERMINAL_TITLE=1
    # Read the command into an array before the cd, so a failure here is
    # reported from a known directory.
    cmd=()
    while IFS= read -r part; do cmd+=("$part"); done < <(agent_command "$a")
    cd "$(start_dir)"
    exec "${cmd[@]}"
    ;;
  *)
    die "usage: gallery agent [status|list|set <name>]"
    ;;
esac
