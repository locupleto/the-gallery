#!/usr/bin/env sh
# yabai configuration for the Gallery's tiler (installed by tiler/install.sh
# to ~/.config/yabai/yabairc). No scripting addition: SIP stays enabled, Spaces are
# switched by the Mission Control hotkeys (Ctrl+N), never by yabai.

# --- layout ------------------------------------------------------------------
yabai -m config layout                  bsp
yabai -m config window_placement        second_child
# New windows open on the display under the pointer.
yabai -m config window_origin_display   cursor
# Even splits, Hyprland style. A 7:5 grid is something to ask for per split (e.g.
# `yabai -m window --ratio abs:0.5833`), not the default.
yabai -m config split_ratio             0.5
yabai -m config split_type              auto
yabai -m config auto_balance            off
yabai -m config window_zoom_persist     on

# --- gaps --------------------------------------------------------------------
yabai -m config window_gap              8
yabai -m config top_padding             8
yabai -m config bottom_padding          8
yabai -m config left_padding            8
yabai -m config right_padding           8

# --- mouse -------------------------------------------------------------------
# Option-drag moves, Option-right-drag resizes, dropping on a tile swaps.
yabai -m config mouse_modifier          alt
yabai -m config mouse_action1           move
yabai -m config mouse_action2           resize
yabai -m config mouse_drop_action       swap
# Hyprland's follow_mouse=1: hovering a window focuses it, so window_origin_display
# cursor (above) and "where focus is" always agree, as they do there. autofocus
# moves focus without raising, so a floating window is not pulled over the tiles.
yabai -m config focus_follows_mouse     autofocus

# Debug output goes to launchd's stdout log (/tmp/yabai_<user>.out.log). Kept on
# since 2026-09-20: yabai forgot live windows four times in three days (a
# spurious AX "destroyed" notification is the only code path), and only its
# own event trace can show which side dropped the ball.
yabai -m config debug_output           on
yabai -m config mouse_follows_focus     off

# --- windows that must never be tiled ----------------------------------------
yabai -m rule --add app="^(System Settings|System Preferences|Calculator|Activity Monitor|Archive Utility|Installer|Software Update|Logi Options\+?|iStat Menus|CleanMyMac X|Digital Colou?r Meter|Font Book|Migration Assistant)$" manage=off
yabai -m rule --add app="^Finder$" title="(Copy|Info|Connect|Move|Delete|Get Info)" manage=off
# Sheets, popovers, dialogs and floating panels. A POSITIVE list on purpose: the
# old form (subrole!="^AXStandardWindow$") also matched a window whose subrole
# could not be read yet at creation (e.g. created while the screen was locked)
# and floated it for good -- Outlook's main window ended up under a full-width
# Safari tile that way. Rules are evaluated once, at creation, so an unknown
# subrole must be left to yabai's default handling, not floated.
yabai -m rule --add label=tiler-float-nonstandard subrole="^AX(Dialog|SystemDialog|Sheet|Popover|FloatingWindow|Unknown)$" manage=off
# The Learn cheat-sheet window (tiler/learn): a floating, centred terminal window,
# whichever of the supported terminals (bin/gallery-term) is configured. The app
# names are the CFBundleName of each: iTerm2, Ghostty, kitty, WezTerm.
yabai -m rule --add app="^(iTerm2|Ghostty|kitty|WezTerm)$" title="^Learn: " manage=off grid=6:6:1:1:4:4

# --- machine-local rules (app -> home Space) ---------------------------------
# Which Space an app belongs on depends on the Mac (display count, Space
# layout), so those rules live OUTSIDE the repo in ~/.config/yabai/rules.local
# -- never installed, never overwritten by tiler/install.sh. Template and
# rationale: tiler/rules.local.example. Sourced after the shared rules so a
# local rule can also override one above; a labelled rule re-added with the
# same label replaces the earlier one (verified on yabai 7.1.25).
[ -r "${HOME}/.config/yabai/rules.local" ] && . "${HOME}/.config/yabai/rules.local"

# --- user overrides: ~/.config/yabai/yabairc.local ---------------------------
# A user-owned, optional file (never installed, never overwritten): any
# `yabai -m config` line in it replaces the shipped value above (gaps, layout,
# mouse modifier, ...), since yabai keeps the last value set; it may add rules
# too. Sourced here, after every shipped config line and rule, so it wins over
# them, but BEFORE `rule --apply` (its rules get applied) and before the
# signals and the border below, which are not meant to be tuned from here (the
# border has `gallery borders`). Template: tiler/yabairc.local.example.
[ -r "${HOME}/.config/yabai/yabairc.local" ] && . "${HOME}/.config/yabai/yabairc.local"
yabai -m rule --apply

# --- keep something focused when a window goes away -------------------------
# macOS leaves keyboard focus with the frontmost APPLICATION, so an app that
# outlives its last window (Claude, Safari, Finder, the web apps: Cmd+W closes
# the window, the app stays) leaves no focused window at all -- super+h/j/k/l
# have no starting point and keystrokes go nowhere until you click. Hyprland
# hands focus to the next window itself; here two signals do it: if no window
# has focus after a destroy/quit, focus the one under the pointer, else the
# most recently focused one. Labelled so a re-run replaces rather than stacks.
yabai -m signal --remove tiler-refocus-destroyed >/dev/null 2>&1
yabai -m signal --remove tiler-refocus-terminated >/dev/null 2>&1
yabai -m signal --add label=tiler-refocus-destroyed event=window_destroyed \
    action='yabai -m query --windows --window >/dev/null 2>&1 || yabai -m window --focus mouse >/dev/null 2>&1 || yabai -m window --focus recent >/dev/null 2>&1'
yabai -m signal --add label=tiler-refocus-terminated event=application_terminated \
    action='yabai -m query --windows --window >/dev/null 2>&1 || yabai -m window --focus mouse >/dev/null 2>&1 || yabai -m window --focus recent >/dev/null 2>&1'

# --- repair a tree that reserves a region no window fills ---------------------
# yabai's tree can keep a node for a window that is no longer tiled (a destroy
# notification it never saw, a window whose AX reference never arrived, a window
# added to the tree twice -- see debug_output above, which is on because this
# desk hits it). The node holds its share of the display, nothing draws in it,
# and the surviving tiles will not grow into it: a stripe of empty desktop,
# often half the screen, that --balance cannot close.
#
# tree-guard measures the tiles against the display's usable rect after each of
# these events and rebuilds ONLY a Space that is genuinely short (see the script
# for the arithmetic and why the threshold is not 1.0). The rebuild costs that
# Space's hand-tuned split ratios, which is exactly why it is measured first
# rather than run on every close. Backgrounded so yabai never waits for it; the
# script takes a lock, so the several events one close can fire collapse into a
# single pass. The same repair is on ctrl+super+r in skhdrc, for by hand.
for e in window_destroyed application_terminated window_minimized space_changed display_changed; do
    yabai -m signal --remove "tree-guard-${e}" >/dev/null 2>&1
    yabai -m signal --add label="tree-guard-${e}" event="${e}" \
        action='"${HOME}/.config/yabai/tree-guard" >/dev/null 2>&1 &'
done

# --- active-window border (JankyBorders) -------------------------------------
# A crisp accent outline around the FOCUSED window only (unfocused windows get
# no border), so the active window is obvious across multiple displays instead
# of being telegraphed only by the red/yellow/green traffic-light buttons.
# borders is a separate daemon (FelixKratz/formulae/borders); it needs no
# scripting addition, so SIP stays enabled.
# The accent follows the active Gallery theme when the-gallery is installed:
# its gallery-borders helper owns the borders invocation and re-syncs the
# colour on every `gallery theme set`. Without the Gallery, fall back to the
# hardcoded launch so the tiler still works standalone (full path + LANG so
# it resolves under launchd; killall keeps it a singleton across restarts).
if [ -x "${HOME}/bin/gallery-borders" ]; then
    "${HOME}/bin/gallery-borders" apply
else
    killall borders 2>/dev/null
    LANG="en_US.UTF-8" /opt/homebrew/bin/borders \
        active_color=0xff7aa2f7 \
        inactive_color=0x00000000 \
        width=5.0 \
        style=round \
        >/dev/null 2>&1 &
fi

echo "yabai configuration loaded"
